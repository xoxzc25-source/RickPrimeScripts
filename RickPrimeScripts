local function measureRigOffset(model, rootPart, hum)
    if not (model and rootPart and rootPart.Parent) then
        if hum then
            if hum.RigType == Enum.HumanoidRigType.R6 then return 3 end
            return (hum.HipHeight or 2) + rootPart.Size.Y / 2
        end
        return 2.8
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Motor6D") then pcall(function() d.Transform = CFrame.new() end) end
    end
    RunService.Heartbeat:Wait()
    local lowest
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") and d ~= rootPart then
            local b = d.Position.Y - d.Size.Y / 2
            if not lowest or b < lowest then lowest = b end
        end
    end
    if lowest then
        return math.clamp(rootPart.Position.Y - lowest, 1.2, 5.2)
    end
    if hum then
        if hum.RigType == Enum.HumanoidRigType.R6 then return 3 end
        return (hum.HipHeight or 2) + rootPart.Size.Y / 2
    end
    return 2.8
end

