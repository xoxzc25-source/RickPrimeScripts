    Debris:AddItem(flash, dur + 0.1)
end

local function makeBeam(origin, hitPos)
    local dist = (hitPos - origin).Magnitude
    if dist < 1 then return end
    local baseRot = CFrame.lookAt(origin, hitPos) * CFrame.Angles(0, math.rad(90), 0)
    local function layer(diameter, color, startTransp)
        local p = Instance.new("Part")
        p.Name = "PrimeBeam"
        p.Material = Enum.Material.Neon
        p.Color = color
        p.Transparency = startTransp
        p.Size = Vector3.new(0.05, diameter, diameter)
        p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
        p.CastShadow = false
        p.CFrame = baseRot * CFrame.new(0.025, 0, 0)
        p.Parent = workspace
        TweenService:Create(p, TweenInfo.new(0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            {Size = Vector3.new(dist, diameter, diameter), CFrame = baseRot * CFrame.new(dist / 2, 0, 0)}):Play()
        task.delay(0.12, function()
            if p and p.Parent then
                TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Transparency = 1}):Play()
            end
        end)
        Debris:AddItem(p, 0.6)
    end
    layer(0.14, Color3.fromRGB(255, 255, 255), 0)
    layer(0.45, CONFIG.BeamColor, 0.2)
    layer(0.95, CONFIG.BeamColor, 0.55)
end

