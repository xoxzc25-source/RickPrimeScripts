local PIECE_BAD = {
    ParticleEmitter = true, Beam = true, Trail = true, Sound = true, PointLight = true,
    SpotLight = true, SurfaceLight = true, Fire = true, Smoke = true, Sparkles = true,
    BillboardGui = true, SurfaceGui = true, Highlight = true,
}

local function buildPieces(char, rootPos)
    local pieces = {}
    local wasArch = char.Archivable
    char.Archivable = true
    local copy = char:Clone()
    char.Archivable = wasArch
    if not copy then return nil, pieces end
    copy.Name = "NanoShatterPieces"

    for _, d in ipairs(copy:GetDescendants()) do
        if d:IsA("LuaSourceContainer") or d:IsA("Tool") or d:IsA("Motor6D")
            or PIECE_BAD[d.ClassName] or d:GetAttribute("NPExclude") or isFx(d) then
            d:Destroy()
        end
    end
    local hrp = copy:FindFirstChild("HumanoidRootPart")
    if hrp then hrp:Destroy() end

    local ch = copy:FindFirstChildOfClass("Humanoid")
    if ch then
        ch.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        ch.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        ch.RequiresNeck = false
        ch.BreakJointsOnDeath = false
        ch.PlatformStand = true
    end

    for _, d in ipairs(copy:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = false
            d.CanCollide, d.CanTouch, d.CanQuery = false, false, false
            d.CastShadow = false
            rawLTM(d, 0)
        elseif d:IsA("Decal") then
            if d.Transparency >= 0.99 then d.Transparency = 0 end
        end
    end
    for _, bp in ipairs(copy:GetChildren()) do
        if bp:IsA("BasePart") then
            if bp.Transparency >= 0.99 then bp.Transparency = 0 end
            bp.CanCollide = true
            bp.Massless = false
            bp.CastShadow = true
            bp.CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.6, 0.35, 1, 1)
            table.insert(pieces, bp)
        end
    end
    copy.Parent = workspace

    for _, bp in ipairs(pieces) do
        local dir = bp.Position - rootPos
        if dir.Magnitude < 0.05 then dir = Vector3.new(math.random() - 0.5, 0.5, math.random() - 0.5) end
        dir = dir.Unit
        local vel = dir * (12 + math.random() * 10) + Vector3.new(0, 8 + math.random() * 8, 0)
        local spin = Vector3.new(math.random() * 16 - 8, math.random() * 16 - 8, math.random() * 16 - 8)
        bp.AssemblyLinearVelocity = vel
        bp.AssemblyAngularVelocity = spin
        spawnBloodBurst(bp.CFrame, 1)
    end
    task.defer(function()
        for _, bp in ipairs(pieces) do
            if bp.Parent and bp.AssemblyLinearVelocity.Magnitude < 3 then
                bp.AssemblyLinearVelocity = (bp.Position - rootPos).Unit * 14 + Vector3.new(0, 12, 0)
            end
        end
    end)
    return copy, pieces
end

function shatterBody()
    if shatterActive then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not root or hum.Health <= 0 then return end

    shatterActive = true
    setStatus("РАСПАД НА ЧАСТИ...")

    task.spawn(function()
        local deathCF = root.CFrame
        local rootPos = root.Position
        playSoundAt(root, TEAR_SOUND_ID, 2, 1, false)
        root.Anchored = true
        hum.BreakJointsOnDeath = false

        local copy, pieces = buildPieces(char, rootPos)

        local guardAlive = true
        if copy then
            task.spawn(function()
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {copy, char}
                while guardAlive and copy.Parent do
                    for _, p in ipairs(pieces) do
                        if p.Parent then
                            local o = p.Position
                            local res = workspace:Raycast(o + Vector3.new(0, 6, 0), Vector3.new(0, -120, 0), rp)
                            if res then
                                if o.Y < res.Position.Y - 0.5 then
                                    p.CFrame = p.CFrame + Vector3.new(0, res.Position.Y - o.Y + p.Size.Y / 2 + 0.3, 0)
                                    local v = p.AssemblyLinearVelocity
                                    p.AssemblyLinearVelocity = Vector3.new(v.X, 6, v.Z)
                                end
                            elseif o.Y < rootPos.Y - 150 then
                                p.CFrame = CFrame.new(rootPos + Vector3.new(math.random() - 0.5, 4, math.random() - 0.5))
                                p.AssemblyLinearVelocity = Vector3.new(0, 8, 0)
                            end
                        end
                    end
                    task.wait(0.08)
                end
            end)
        end

        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Transparency = 1
                obj.CanCollide = false
                rawLTM(obj, 1)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Light") then
                obj.Enabled = false
            end
        end
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
                or c:IsA("CharacterMesh") or c:IsA("Tool") then
                c:Destroy()
            end
        end

        hum.Health = 0
        hum:ChangeState(Enum.HumanoidStateType.Dead)

        local newChar = nil
        local conn = LocalPlayer.CharacterAdded:Connect(function(c) newChar = c end)
        local t0 = os.clock()
        local maxWait = math.max(Players.RespawnTime + 5, 15)
        while not newChar and os.clock() - t0 < maxWait do task.wait(0.1) end
        conn:Disconnect()

        if not newChar then
            guardAlive = false
            if copy and copy.Parent then copy:Destroy() end
            setStatus("РЕСПАВН НЕ ПРИШЁЛ (ПРОВЕРЬ АВТО-РЕСПАВН)")
            shatterActive = false
            return
        end

        guardAlive = false
        if copy and copy.Parent then
            for _, d in ipairs(copy:GetDescendants()) do
                if d:IsA("BasePart") then
                    TweenService:Create(d, TweenInfo.new(0.35), {Transparency = 1}):Play()
                end
            end
            Debris:AddItem(copy, 0.5)
        end
        if char and char.Parent then char:Destroy() end

        local stopHide = hideCharacter(newChar)

        local respawnCF = deathCF

        local newRoot = newChar:WaitForChild("HumanoidRootPart", 10)
        if newRoot then
            task.wait(0.2)
            newRoot.CFrame = respawnCF
            task.wait(0.25)
            newRoot.CFrame = respawnCF
            spawnPortalFlash(newRoot, COLOR_FLASH_OUT)
            playSoundAt(newRoot, SHATTER_SOUND_ID, 2, 1, false)
            waitAppearance(2.5)
            local nhum = newChar:FindFirstChildOfClass("Humanoid")
            if nhum and workspace.CurrentCamera then
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                workspace.CurrentCamera.CameraSubject = nhum
            end
        end

        setStatus("ТЕЛО ВОССТАНОВЛЕНО // ПОЛНАЯ СБОРКА")

        local function unhideParts(names)
            for _, n in ipairs(names) do
                local p = newChar:FindFirstChild(n)
                if p then
                    setLTM(p, 0)
                    for _, dd in ipairs(p:GetDescendants()) do
                        if dd:IsA("Decal") then setLTM(dd, 0) end
                    end
                end
            end
        end

        local rigHum = newChar:FindFirstChildOfClass("Humanoid")
        local newIsR6 = rigHum and rigHum.RigType == Enum.HumanoidRigType.R6
        local limbTable2 = newIsR6 and R6_LIMBS or R15_LIMBS
        local torsoNames2 = newIsR6 and TORSO_PARTS.R6 or TORSO_PARTS.R15

        runHeadPrint(newChar)

        for i, limbName in ipairs({"Torso", "RightArm", "LeftArm", "RightLeg", "LeftLeg"}) do
            task.delay(0.25 * (i - 1), function()
                if not newChar.Parent then return end
                if limbName == "Torso" then
                    unhideParts(torsoNames2)
                    busyLimbs[limbName] = false
                    regenerateTorso()
                else
                    unhideParts(limbTable2[limbName] or {})
                    busyLimbs[limbName] = false
                    regenerateLimb(limbName)
                end
            end)
        end

        task.delay(4.5, function()
            stopHide()
            if newChar and newChar.Parent then
                for _, d in ipairs(newChar:GetDescendants()) do showObj(d) end
            end
        end)
        shatterActive = false
    end)
end

