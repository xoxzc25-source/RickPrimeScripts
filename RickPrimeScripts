        local waitSession = sawSession
        task.spawn(function()
            local t0 = os.clock()
            while busyLimbs["Head"] and os.clock() - t0 < 30 do task.wait(0.1) end
            if waitSession == sawSession and sawOwned then safeCall("ПИЛА", giveSaw) end
        end)
