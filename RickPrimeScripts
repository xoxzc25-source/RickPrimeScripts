local function removePrintPart(inst)
    for i = #activePrints, 1, -1 do
        if activePrints[i].Instance == inst then
            if inst and inst.Parent then inst:Destroy() end
            table.remove(activePrints, i)
            return
        end
    end
end

function cancelAllPrints()
    printEpoch += 1
    for i = #activePrints, 1, -1 do
        local rec = activePrints[i]
        if rec.Instance and rec.Instance.Parent then rec.Instance:Destroy() end
        table.remove(activePrints, i)
    end
    for i = #activeBots, 1, -1 do
        local b = activeBots[i]
        if b.Part and b.Part.Parent then b.Part:Destroy() end
        table.remove(activeBots, i)
    end
    for p, snap in pairs(skinSnapshots) do
        if p and p.Parent then p.Transparency = snap.Transparency end
    end
    table.clear(skinSnapshots)
    table.clear(busyLimbs)
    printSoundUsers = 0
    if activePrintSound then
        pcall(function() activePrintSound:Destroy() end)
        activePrintSound = nil
    end
end

local function finishPrint(limbName, parts)
    for i = #activePrints, 1, -1 do
        if activePrints[i].Limb == limbName then
            local inst = activePrints[i].Instance
            if inst and inst.Parent then inst:Destroy() end
            table.remove(activePrints, i)
        end
    end
    for i = #activeBots, 1, -1 do
        if activeBots[i].Limb == limbName then
            local b = activeBots[i]
            if b.Part and b.Part.Parent then
                b.State = "Out"; b.OutAt = os.clock()
            else
                table.remove(activeBots, i)
            end
        end
    end
    for _, p in ipairs(parts) do
        if p and p.Parent then
            local snap = skinSnapshots[p]
            p.Transparency = snap and snap.Transparency or 0
            spawnPortalFlash(p, COLOR_FLASH_OUT)
        end
    end
    endPrintSound()
    busyLimbs[limbName] = false
    setStatus("ГОТОВО // " .. limbName)
end

local function runPrintSequence(limbName, parts)
    setStatus("СБОРКА: " .. limbName)
    local epoch = printEpoch
    task.spawn(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or #parts == 0 then
            busyLimbs[limbName] = false
            setStatus("ОШИБКА: НЕТ ТЕЛА")
            return
        end
        local anchorPart = parts[1]
        local speed = CONFIG.RegenSpeed
        local totalTime = (VANISH_TIME + BONE_FADE + NERVE_FADE + FLESH_FADE + SKIN_FADE + 0.35) * speed
        startPrintSound(anchorPart, totalTime)

        local ok, err = pcall(function()
            for _, p in ipairs(parts) do
                skinSnapshots[p] = {Color = p.Color, Material = p.Material, Transparency = p.Transparency}
            end
            for _, p in ipairs(parts) do
                p.Transparency = 1
                spawnPortalFlash(p, COLOR_FLASH_IN)
            end
            spawnBots(anchorPart, limbName)
            task.wait(VANISH_TIME * speed + 0.25)
            if epoch ~= printEpoch then return end

            local torsoMode = (limbName == "Torso")
            local L = lite()

            local boneMap = {}
            for _, p in ipairs(parts) do
                local top = CFrame.new(0, p.Size.Y / 2, 0)
                local boneLen = p.Size.Y * 0.98
                local boneDiameter = math.min(p.Size.X, p.Size.Z) * (torsoMode and 0.38 or 0.3)
                local bone = bioPart("Bone", Vector3.new(boneLen, boneDiameter, boneDiameter),
                    BONE_COLOR, Enum.Material.Slate, BONE_FADE, p, top, 0, true, limbName)
                if bone then
                    boneMap[p] = {
                        bone = bone, top = top, len = boneLen, diam = boneDiameter,
                        scanner = spawnScanner(bone, boneDiameter, boneDiameter, limbName, true, BONE_FADE)
                    }
                end
            end
            if torsoMode then
                buildTorsoSkeleton(parts, limbName)
            elseif not L then
                local main = boneMap[anchorPart]
                if main then
                    local bone2D = main.diam * 0.55
                    bioPart("Bone2", Vector3.new(main.len * 0.92, bone2D, bone2D), BONE_COLOR,
                        Enum.Material.Slate, BONE_FADE, anchorPart, main.top * CFrame.new(0, 0, main.diam / 2 + bone2D / 2 + 0.02), 0, true, limbName)
                    local ridgeLen = main.len * 0.72
                    bioNode("BoneRidge", Vector3.new(ridgeLen, 0.05, 0.05), BONE_COLOR, Enum.Material.Slate, BONE_FADE, main.bone, 0.06, 0, false, "X", limbName,
                        CFrame.new(0, main.diam / 2 + 0.02, 0))
                    bioNode("BoneRidge", Vector3.new(ridgeLen, 0.05, 0.05), BONE_COLOR, Enum.Material.Slate, BONE_FADE, main.bone, -0.06, 0, false, "X", limbName,
                        CFrame.new(0, -main.diam / 2 - 0.02, 0))
                end
            end
            setStatus("СБОРКА: " .. limbName .. " // КАРКАС")
            task.wait(BONE_FADE * speed)
            if epoch ~= printEpoch then return end
            for _, rec in pairs(boneMap) do
                if rec.scanner then removePrintPart(rec.scanner) end
            end

            for _, p in ipairs(parts) do
                local rec = boneMap[p]
                if rec and p.Size.Y >= 0.8 then
                    buildNerveSystem(p, rec.len, rec.diam, rec.bone, rec.top, limbName)
                end
            end
            setStatus("СБОРКА: " .. limbName .. " // СЕТЬ")
            task.wait(NERVE_FADE * speed)
            if epoch ~= printEpoch then return end

            local fleshMap = {}
            for _, p in ipairs(parts) do
                local fs = p.Size * 0.96
                local flesh = bioPart("Flesh", fs, FLESH_COLOR, Enum.Material.SmoothPlastic, FLESH_FADE, p,
                    CFrame.new(0, p.Size.Y / 2, 0), 0, false, limbName)
                if flesh then
                    fleshMap[p] = spawnScanner(flesh, fs.X, fs.Z, limbName, false, FLESH_FADE)
                end
            end
            if torsoMode then
                buildTorsoOrgans(parts, limbName)
                buildTorsoMuscles(parts, limbName)
            else
                local main = boneMap[anchorPart]
                if main then
                    local fleshSize = anchorPart.Size * 0.96
                    local fiberRX = fleshSize.X / 2 - 0.06
                    local fiberRZ = fleshSize.Z / 2 - 0.06
                    local fc = L and 2 or 4
                    for i = 1, fc do
                        local angle = (i - 1) * (L and math.pi or math.pi / 2) + math.pi / 4
                        bioPart("Fiber" .. i, Vector3.new(0.07, fleshSize.Y * 0.97, 0.07), FIBER_COLOR,
                            Enum.Material.SmoothPlastic, FLESH_FADE, anchorPart,
                            main.top * CFrame.new(math.cos(angle) * fiberRX, 0, math.sin(angle) * fiberRZ), 0, false, limbName)
                    end
                end
            end
            setStatus("СБОРКА: " .. limbName .. " // ТКАНЬ")
            task.wait(FLESH_FADE * speed)
            if epoch ~= printEpoch then return end
            for _, sc in pairs(fleshMap) do
                if sc then removePrintPart(sc) end
            end

            for i = #activePrints, 1, -1 do
                local rec = activePrints[i]
                if rec.Limb == limbName and rec.Instance and rec.Instance.Parent then
                    TweenService:Create(rec.Instance,
                        TweenInfo.new(0.25 * speed, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
                        {Transparency = 1}):Play()
                end
            end

            for _, p in ipairs(parts) do
                local snap = skinSnapshots[p]
                bioPart("Skin", p.Size * 1.01,
                    snap and snap.Color or p.Color,
                    (snap and snap.Material) or Enum.Material.SmoothPlastic,
                    SKIN_FADE, p, CFrame.new(0, p.Size.Y / 2, 0), 0, false, limbName)
            end
            setStatus("СБОРКА: " .. limbName .. " // КОЖА")
            task.wait((SKIN_FADE + 0.1) * speed)
        end)

        if epoch ~= printEpoch then return end
        if not ok then
            warn("[NanoPrime] ошибка печати:", err)
            setStatus("ОШИБКА // " .. limbName)
        end
        finishPrint(limbName, parts)
    end)
end

function regenerateLimb(limbName)
    if busyLimbs[limbName] then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local limbTable = (hum.RigType == Enum.HumanoidRigType.R6) and R6_LIMBS or R15_LIMBS
    local names = limbTable[limbName]
    if not names then return end
    local parts = {}
    for _, name in ipairs(names) do
        local p = char:FindFirstChild(name)
        if p then table.insert(parts, p) end
    end
    if #parts == 0 then return end
    busyLimbs[limbName] = true
    runPrintSequence(limbName, parts)
end

function regenerateTorso()
    if busyLimbs["Torso"] then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local names = (hum.RigType == Enum.HumanoidRigType.R6) and TORSO_PARTS.R6 or TORSO_PARTS.R15
    local parts = {}
    for _, name in ipairs(names) do
        local p = char:FindFirstChild(name)
        if p then table.insert(parts, p) end
    end
    if #parts == 0 then return end
    busyLimbs["Torso"] = true
    runPrintSequence("Torso", parts)
end

function pickRandomFreeLimb()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local limbTable = (hum.RigType == Enum.HumanoidRigType.R6) and R6_LIMBS or R15_LIMBS
    local free = {}
    for name in pairs(limbTable) do
        if not busyLimbs[name] then table.insert(free, name) end
    end
    if #free == 0 then return nil end
    return free[math.random(1, #free)]
end

