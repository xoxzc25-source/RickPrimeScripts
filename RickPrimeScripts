local function startCatching(rec, session)
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if session ~= portalSession or not portalArmed then
            conn:Disconnect()
            if portalCatchConn == conn then portalCatchConn = nil end
            return
        end
        if rec.closing or not (rec.model and rec.model.Parent) then return end
        local center = rec.center
        for _, child in ipairs(workspace:GetChildren()) do
            if child.Name == "PrimeBombBody" and child:IsA("BasePart") then
                local cur = child.Position
                local prev = lastBombPos[child] or cur
                lastBombPos[child] = cur
                if segDist(prev, cur, center) < PORTAL_CATCH_R then
                    portalArmed = false
                    conn:Disconnect()
                    portalCatchConn = nil
                    local vChar = portalDestChar
                    portalRec = nil
                    task.spawn(function()
                        safeCall("ПОРТАЛ", function()
                            deliverBomb(child, rec, vChar, session)
                        end)
                    end)
                    return
                end
            end
        end
    end)
    portalCatchConn = conn
end

