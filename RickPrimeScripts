local KNOB_R = 10

local function makeSlider(text, min, max, default, fmt, cb, parent)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 50)
    holder.BackgroundTransparency = 1
    holder.Parent = parent
    holder.LayoutOrder = order(1)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 14)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 9
    lbl.TextColor3 = COLOR_NEON
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, 0, 0, 28)
    bar.Position = UDim2.new(0, 0, 0, 20)
    bar.BackgroundColor3 = COLOR_SLIDER_BG
    bar.BorderSizePixel = 0
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = holder
    corner(bar, 14)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 2 * KNOB_R, 1, 0)
    fill.BackgroundColor3 = COLOR_NEON
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 14)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(KNOB_R * 2, KNOB_R * 2)
    knob.BackgroundColor3 = Color3.fromRGB(235, 240, 245)
    knob.BorderSizePixel = 0
    knob.ZIndex = 3
    knob.Position = UDim2.new(0, KNOB_R, 0.5, 0)
    knob.Parent = bar
    corner(knob, 9)

    local lastPct = math.clamp((default - min) / (max - min), 0, 1)

    local function fmtValue(v)
        if fmt == "int" then return string.format("%d", math.floor(v + 0.5)) end
        if fmt == "f2" then return string.format("%.2f", v) end
        if fmt == "sec" then return string.format("%.1f", v) .. " с" end
        return string.format("%.1f", v) .. "x"
    end

    local function apply(pct)
        lastPct = math.clamp(pct, 0, 1)
        fill.Size = UDim2.new(lastPct, 2 * KNOB_R * (1 - lastPct), 1, 0)
        knob.Position = UDim2.new(lastPct, KNOB_R * (1 - 2 * lastPct), 0.5, 0)
        local value = min + (max - min) * lastPct
        lbl.Text = text .. "  ->  " .. fmtValue(value)
        cb(value)
    end

    local function applyFromScreen(xScreen)
        local w = bar.AbsoluteSize.X - 2 * KNOB_R
        if w <= 0 then return end
        apply((xScreen - bar.AbsolutePosition.X - KNOB_R) / w)
    end

    local dragging = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            applyFromScreen(input.Position.X)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            applyFromScreen(input.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    task.defer(apply, lastPct)
end

