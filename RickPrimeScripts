    p.Name = "Nano" .. name
    p.Shape = shape or Enum.PartType.Block
    p.Size = grow and Vector3.new(0.05, 0.05, 0.05) or size
    p.Color, p.Material = color, material
    p.Transparency = grow and (finalT or 0) or 1
    p.CanCollide, p.CanTouch, p.CanQuery, p.Massless, p.Anchored = false, false, false, true, false
    p.CastShadow = false
    p.Parent = char
    local w = Instance.new("Weld")
    w.Part0, w.Part1 = host, p
    w.C0 = cfr
    w.Parent = p
    table.insert(activePrints, {Instance = p, Limb = limbTag, Mode = "Plain"})
    local info = TweenInfo.new(dur * CONFIG.RegenSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    if grow then
        TweenService:Create(p, info, {Size = size}):Play()
    else
        TweenService:Create(p, info, {Transparency = finalT or 0}):Play()
    end
    return p
end

local function tBone(host, name, a, b, thick, color, material, dur, limbTag)
    local len = (b - a).Magnitude
    if len < 0.02 then return nil end
    return torsoPart(name, host, CFrame.lookAt((a + b) / 2, b), Vector3.new(thick, thick, len),
        color, material, dur, nil, false, limbTag, 0)
end

local function torsoHosts(parts)
    local upper, lower
    for _, p in ipairs(parts) do
        if p.Name == "LowerTorso" then lower = p else upper = upper or p end
    end
    return upper, lower
end

local function buildRibcage(host, tag)
    local L = lite()
    local sx, sy, sz = host.Size.X, host.Size.Y, host.Size.Z
    local S = Enum.Material.Slate
    local top, bottom = sy * 0.42, -sy * 0.08
    local n = L and 4 or 6
    local step = (top - bottom) / n
    for i = 1, n do
        local y = top - (i - 0.5) * step
        local w = 0.62 + 0.38 * math.sin(math.pi * (i - 0.4) / (n + 0.3))
        for _, sd in ipairs({-1, 1}) do
            local back = Vector3.new(sd * sx * 0.08, y, sz * 0.26)
            local side = Vector3.new(sd * sx * 0.44 * w, y - step * 0.25, sz * 0.02)
            local front = Vector3.new(sd * sx * 0.1, y - step * 0.75, -sz * 0.4)
            tBone(host, "RibBack", back, side, 0.07, BONE_COLOR, S, BONE_FADE, tag)
            tBone(host, "RibFront", side, front, 0.07, BONE_COLOR, S, BONE_FADE, tag)
        end
    end
    torsoPart("Sternum", host, CFrame.new(0, (top + bottom) / 2 - step * 0.2, -sz * 0.42),
        Vector3.new(0.14, (top - bottom) * 0.85, 0.08), BONE_COLOR, S, BONE_FADE, nil, true, tag, 0)
    for _, sd in ipairs({-1, 1}) do
        tBone(host, "Clavicle", Vector3.new(sd * sx * 0.08, sy * 0.45, -sz * 0.38),
            Vector3.new(sd * sx * 0.46, sy * 0.46, -sz * 0.08), 0.09, BONE_COLOR, S, BONE_FADE, tag)
        if not L then
            torsoPart("Scapula", host, CFrame.new(sd * sx * 0.27, sy * 0.26, sz * 0.4) * CFrame.Angles(0, 0, sd * math.rad(10)),
                Vector3.new(sx * 0.22, sy * 0.2, 0.06), BONE_COLOR, S, BONE_FADE, nil, true, tag, 0)
        end
    end
    local vc = L and 4 or math.clamp(math.floor(sy * 4), 4, 8)
    for i = 1, vc do
        local y = sy * 0.44 - (i - 1) * (sy * 0.88 / (vc - 1))
        torsoPart("Vertebra", host, CFrame.new(0, y, 0), Vector3.new(0.34, 0.09, 0.3),
            BONE_COLOR, S, BONE_FADE, nil, false, tag, 0)
    end
end

local function buildPelvis(host, cy, tag)
    local sx, sz = host.Size.X, host.Size.Z
    local B, S = BONE_COLOR, Enum.Material.Slate
    torsoPart("Sacrum", host, CFrame.new(0, cy, sz * 0.3), Vector3.new(sx * 0.2, 0.42, 0.14), B, S, BONE_FADE, nil, true, tag, 0)
    torsoPart("Pubis", host, CFrame.new(0, cy - 0.2, -sz * 0.3), Vector3.new(sx * 0.34, 0.1, 0.1), B, S, BONE_FADE, nil, true, tag, 0)
    for _, sd in ipairs({-1, 1}) do
        torsoPart("Ilium", host, CFrame.new(sd * sx * 0.3, cy + 0.08, 0.02) * CFrame.Angles(0, 0, -sd * math.rad(20)),
            Vector3.new(sx * 0.3, 0.5, 0.12), B, S, BONE_FADE, nil, true, tag, 0)
        torsoPart("HipSocket", host, CFrame.new(sd * sx * 0.25, cy - 0.2, 0), Vector3.new(0.36, 0.36, 0.36),
            B, S, BONE_FADE, Enum.PartType.Ball, true, tag, 0)
        torsoPart("FemurHead", host, CFrame.new(sd * sx * 0.25, cy - 0.32, 0), Vector3.new(0.3, 0.3, 0.3),
