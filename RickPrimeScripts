local function throwBomb()
    local tool = bombTool
    if not tool or not tool.Parent then return end
    if os.clock() - bombLastThrow < CONFIG.BombCD then return end
    if activeBombs >= 4 then return end
    local char = LocalPlayer.Character
    local handle = tool:FindFirstChild("Handle")
    local cam = workspace.CurrentCamera
    if not char or not handle or not cam then return end
    bombLastThrow = os.clock()

    local origin = handle.Position + Vector3.new(0, 0.3, 0)
    local m = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(m.X, m.Y)
    local res = workspace:Raycast(ray.Origin, ray.Direction * 300, rayParams({char}))
    local aim = res and res.Position or (ray.Origin + ray.Direction * 80)
    local vec = aim - origin
    if vec.Magnitude > 95 then
        vec = vec.Unit * 95
    end
    local dist = vec.Magnitude
    local t = math.clamp(dist / 55, 0.35, 1.5)
    local g = Vector3.new(0, -workspace.Gravity, 0)
    local vel = (vec - 0.5 * g * t * t) / t

    setBombToolVisible(false)
    task.delay(0.9, function()
        if bombTool and bombTool.Parent then setBombToolVisible(true) end
    end)
    setStatus("БОМБА ПРАЙМА БРОШЕНА // ТИКАЕТ...")

    task.spawn(function()
        activeBombs += 1
        local body, led, light = buildBombBody(char)
        body.CFrame = CFrame.new(origin)
        body.Parent = workspace
        body.AssemblyLinearVelocity = vel
        body.AssemblyAngularVelocity = Vector3.new(math.random() * 14 - 7, math.random() * 14 - 7, math.random() * 14 - 7)

        local tickSnd = playSoundAt(body, CONFIG.BombTickId, 2, 1, false)

        local t0 = os.clock()
        local last = t0
        local fuse = CONFIG.BombFuse
        local nextBeep = 0
        local settled = 0
        local charged = false
        local fallen = false

        while body.Parent do
            local now = os.clock()
            local dt = now - last
            last = now
            local tt = now - t0
            if tt >= fuse then break end
            local prog = tt / fuse

            if tt >= nextBeep then
                led.Color = Color3.fromRGB(255, 255, 255)
                light.Brightness = 6
                TweenService:Create(led, TweenInfo.new(0.12), {Color = BOMB_PINK}):Play()
                TweenService:Create(light, TweenInfo.new(0.15), {Brightness = 1.4}):Play()
                nextBeep = tt + math.max(0.09, 0.62 * (1 - prog) + 0.08)
            end

            if not charged and tt >= fuse - 0.45 then
                charged = true
                led.Color = Color3.fromRGB(255, 255, 255)
                TweenService:Create(light, TweenInfo.new(0.4), {Brightness = 10, Range = 28}):Play()
                local bub = Instance.new("Part")
                bub.Name = "PrimeBombCharge"
                bub.Shape = Enum.PartType.Ball
                bub.Material = Enum.Material.Neon
                bub.Color = BOMB_PINK
                bub.Transparency = 0.55
                bub.Size = Vector3.new(1.5, 1.5, 1.5)
                bub.Anchored, bub.CanCollide, bub.CanTouch, bub.CanQuery, bub.CastShadow = true, false, false, false, false
                bub.CFrame = CFrame.new(body.Position)
                bub.Parent = workspace
                TweenService:Create(bub, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    {Size = Vector3.new(4.2, 4.2, 4.2), Transparency = 0.9}):Play()
                Debris:AddItem(bub, 0.5)
            end

            if not body.Anchored and tt > 0.5 then
                if body.AssemblyLinearVelocity.Magnitude < 1.2 then settled += dt else settled = 0 end
                if settled > 0.25 then
                    body.AssemblyLinearVelocity = Vector3.zero
                    body.Anchored = true
                end
            end

            local fh = workspace.FallenPartsDestroyHeight
            if fh == fh and body.Position.Y < fh + 5 then
                fallen = true
                break
            end
            task.wait()
        end

        if tickSnd and tickSnd.Parent then
            pcall(function() tickSnd:Stop(); tickSnd:Destroy() end)
        end

        if body.Parent and not fallen then
            local pos = body.Position
            body:Destroy()
            bombBlast(pos)
        elseif body.Parent then
            body:Destroy()
        end
        activeBombs = math.max(0, activeBombs - 1)
    end)
end

