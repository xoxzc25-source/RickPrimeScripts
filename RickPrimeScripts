local function holoStreak(from, to, w0, dur, coreColor)
    local host = holoAnchor(from)
    local att0 = Instance.new("Attachment"); att0.Parent = host
    local att1 = Instance.new("Attachment"); att1.Position = to - from; att1.Parent = host

    local beam = Instance.new("Beam")
    beam.Attachment0, beam.Attachment1 = att0, att1
    beam.Color = ColorSequence.new(coreColor or Color3.fromRGB(210, 248, 255), CONFIG.BotColor)
    beam.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(0.75, 0.4),
        NumberSequenceKeypoint.new(1, 0.9),
    })
    beam.Width0, beam.Width1 = w0, 0.03
    beam.LightEmission, beam.LightInfluence = 1, 0
    beam.FaceCamera = true
    beam.Parent = host

    task.spawn(function()
        local t0 = os.clock()
        while beam.Parent and os.clock() - t0 < dur do
            local a = math.clamp((os.clock() - t0) / dur, 0, 1)
            beam.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.05 + a * 0.95),
                NumberSequenceKeypoint.new(0.75, 0.4 + a * 0.6),
                NumberSequenceKeypoint.new(1, math.min(0.9 + a * 0.1, 1)),
