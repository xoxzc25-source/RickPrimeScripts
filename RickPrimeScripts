function giveDrone()
    if droneOwned and droneModel and droneModel.Parent then
        removeDrone()
        setStatus("ДРОН: УБРАН")
        return
    end
    if droneOwned then
        removeDrone()
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        setStatus("ДРОН: НЕТ ТЕЛА")
        return
    end

    droneOwned = true
    droneModel = buildModel()
    if not (droneModel and droneCore) then
        droneOwned = false
        setStatus("ДРОН: ОШИБКА СБОРКИ")
        return
    end
    droneCore.CFrame = root.CFrame * CFrame.new(4, 2, 0)
    droneModel.Parent = workspace
    droneT = 0
    droneState = "ORBIT"
    droneTarget = nil
    _G.__npDroneMounted = false

    droneConn = RunService.Heartbeat:Connect(function(dt)
        if not (droneModel and droneCore and droneCore.Parent) then return end
        droneT += dt

        if droneEyeLight and droneEyeLight.Parent then
            droneEyeLight.Brightness = 3 + math.sin(droneT * 5) * 0.6
        end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if droneRiderHum then
            if not (root and hum and hum.Health > 0) or droneRiderChar ~= char then
                forceDismount("ДРОН: РАЗВАР // ВОЗВРАТ НА ОРБИТУ")
                return
            end
            if not droneCore.Anchored then droneCore.Anchored = true end

            local typing = UserInputService:GetFocusedTextBox() ~= nil
            local function key(kc)
                return (not typing) and (UserInputService:IsKeyDown(kc) or (_G.__npVKey and _G.__npVKey[kc] == true))
            end
            if key(Enum.KeyCode.R) then
                forceDismount("ДРОН: СЛЕЗ // ВОЗВРАТ НА ОРБИТУ")
                return
            end

            local cam = workspace.CurrentCamera
            local camCF = cam and cam.CFrame or CFrame.new()
            local move = Vector3.zero
            if key(Enum.KeyCode.W) then move += camCF.LookVector end
            if key(Enum.KeyCode.S) then move -= camCF.LookVector end
            if key(Enum.KeyCode.D) then move += camCF.RightVector end
            if key(Enum.KeyCode.A) then move -= camCF.RightVector end
            if key(Enum.KeyCode.Space) then move += Vector3.yAxis end
            if key(Enum.KeyCode.LeftShift) then move -= Vector3.yAxis end

            local targetVel = (move.Magnitude > 0.05) and (move.Unit * droneSpeed) or Vector3.zero
            if move.Magnitude <= 0.05 then
                targetVel = Vector3.new(0, 2, 0)
            end
            flyVel = flyVel:Lerp(targetVel, 1 - math.exp(-dt * 6))

            if flyVel.Magnitude > 1 then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {droneModel, char}
                local hit = workspace:Raycast(root.Position, flyVel.Unit * (flyVel.Magnitude * dt + 2.2), rp)
                if hit then
                    local n = hit.Normal
                    local into = flyVel:Dot(n)
                    if into < 0 then
                        flyVel = flyVel - n * into
                    end
                end
            end

            local fh = workspace.FallenPartsDestroyHeight
            if fh == fh and root.Position.Y < fh + 6 and flyVel.Y < 0 then
                flyVel = Vector3.new(flyVel.X, 0, flyVel.Z)
            end

            if riderLV and riderLV.Parent then
                riderLV.VectorVelocity = flyVel
            end

            local look = camCF.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.05 then flat = Vector3.new(0, 0, -1) end
            flat = flat.Unit
            local pitch, roll = 0, 0
            if move.Magnitude > 0.05 and move.Y == 0 then
                pitch = math.clamp(-look.Y * 0.3, -0.4, 0.4)
                roll = math.clamp(-move.Unit:Dot(camCF.RightVector) * 0.12, -0.2, 0.2)
            end
            if riderAO and riderAO.Parent then
                riderAO.CFrame = CFrame.lookAt(Vector3.zero, flat) * CFrame.Angles(pitch, 0, roll)
            end

            local bob = (move.Magnitude <= 0.05) and math.sin(droneT * 2) * 0.06 or 0
            droneCore.CFrame = (root.CFrame * DRONE_FOLLOW) + Vector3.new(0, bob, 0)
            return
        end

        if not root or not hum or hum.Health <= 0 then return end
        if not droneCore.Anchored then droneCore.Anchored = true end

        if droneState == "CHASE" then
            local tRoot = droneTarget and droneTarget.Parent and droneTarget:FindFirstChild("HumanoidRootPart")
            local tHum = droneTarget and droneTarget.Parent and droneTarget:FindFirstChildOfClass("Humanoid")
            if not (tRoot and tHum and tHum.Health > 0)
                or (tRoot.Position - root.Position).Magnitude > 90 then
                droneState = "ORBIT"; droneTarget = nil; eyeColor(false)
            else
                local dist = (tRoot.Position - droneCore.Position).Magnitude
                if dist < 4.5 then
                    if droneFlT == 0 then
                        droneFlT = os.clock()
                        droneState = "HOLD"
                        enqueueFling(droneTarget)
                    end
                else
                    local goal = tRoot.Position + Vector3.new(0, 1.2, 0)
                    local a = 1 - math.exp(-dt * 7)
                    droneCore.CFrame = droneCore.CFrame:Lerp(CFrame.lookAt(goal, tRoot.Position), a)
                end
                return
            end
        elseif droneState == "HOLD" then
            if os.clock() - droneFlT > (CONFIG.FlingTime or 1) + 1.0 then
                droneState = "ORBIT"; droneTarget = nil; droneFlT = 0; eyeColor(false)
            end
            return
        end

        local ang = droneT * ORBIT_SPEED
        local goal = root.Position
            + Vector3.new(math.cos(ang) * ORBIT_R, ORBIT_H + math.sin(droneT * 2) * 0.3, math.sin(ang) * ORBIT_R)
        local a = 1 - math.exp(-dt * 4)
        local newPos = droneCore.Position:Lerp(goal, a)
        local lookAt = root.Position + root.CFrame.LookVector * 8
        droneCore.CFrame = CFrame.lookAt(newPos, lookAt)
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not (droneModel and droneCore and droneCore.Parent) then return end
        if droneRiderHum then return end
        if droneState ~= "ORBIT" then return end
        local char = LocalPlayer.Character
        if not char or char:FindFirstChildOfClass("Tool") then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local m = UserInputService:GetMouseLocation()
        local ray = cam:ViewportPointToRay(m.X, m.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, droneModel}
        local res = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
        local model = res and res.Instance:FindFirstAncestorOfClass("Model")
        local hum = model and model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and model ~= char
            and model.Name ~= "NanoShatterPieces" and model.Name ~= "PrimeDouble" then
            droneTarget = model
            droneState = "CHASE"
            droneFlT = 0
            eyeColor(true)
            setStatus("ДРОН: АТАКА // " .. model.Name)
        end
    end)

    if droneButtonRefresh then droneButtonRefresh() end
    setStatus("ДРОН ВЫЗВАН // ВСТАТЬ НА НЕГО — КНОПКА В МЕНЮ")
end

