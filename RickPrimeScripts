local function portalBuildBomb(pos)
    local body = Instance.new("Part")
    body.Name = "PrimePortalBomb"
    body.Shape = Enum.PartType.Ball
    body.Size = Vector3.new(1.2, 1.2, 1.2)
    body.Color = BOMB_SHELL
    body.Material = Enum.Material.Metal
    body.Anchored = true
    body.CanCollide, body.CanTouch, body.CanQuery = false, false, false
    body.CFrame = CFrame.new(pos)
    body.Parent = workspace

    local R = body.Size.X / 2
    local N = 14
    local golden = math.pi * (3 - math.sqrt(5))
    for i = 0, N - 1 do
        local y = 1 - (i / math.max(N - 1, 1)) * 2
        local rad = math.sqrt(math.max(0, 1 - y * y))
        local th = golden * i
        local dir = Vector3.new(math.cos(th) * rad, y, math.sin(th) * rad)
        local baseCF = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(0, math.rad(90), 0)

        local socket = Instance.new("Part")
        socket.Size = Vector3.new(0.14, 0.34, 0.34)
        socket.Color = BOMB_RIM
        socket.Material = Enum.Material.Metal
        socket.Anchored, socket.Massless, socket.CanCollide, socket.CanTouch, socket.CanQuery = false, true, false, false, false
        local sw = Instance.new("Weld")
        sw.Part0, sw.Part1 = body, socket
        sw.C0 = baseCF * CFrame.new(R * 0.86, 0, 0)
        sw.Parent = socket
        socket.Parent = body

        local glow = Instance.new("Part")
        glow.Size = Vector3.new(0.08, 0.22, 0.22)
        glow.Color = BOMB_PINK
        glow.Material = Enum.Material.Neon
        glow.Anchored, glow.Massless, glow.CanCollide, glow.CanTouch, glow.CanQuery = false, true, false, false, false
        local gw = Instance.new("Weld")
        gw.Part0, gw.Part1 = body, glow
        gw.C0 = baseCF * CFrame.new(R * 0.96, 0, 0)
        gw.Parent = glow
        glow.Parent = body
    end

    local led = Instance.new("Part")
    led.Shape = Enum.PartType.Ball
    led.Size = Vector3.new(0.2, 0.2, 0.2)
    led.Color = BOMB_PINK
    led.Material = Enum.Material.Neon
    led.Anchored, led.Massless, led.CanCollide, led.CanTouch, led.CanQuery = false, true, false, false, false
    local lw = Instance.new("Weld")
    lw.Part0, lw.Part1 = body, led
    lw.C0 = CFrame.new(0, R * 1.02, 0)
    lw.Parent = led
    led.Parent = body

    local pl = Instance.new("PointLight")
    pl.Color = BOMB_PINK
    pl.Brightness = 3
    pl.Range = 10
    pl.Parent = led

    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    pe.Color = ColorSequence.new(BOMB_PINK, BOMB_PURPLE)
    pe.LightEmission = 1
    pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.16), NumberSequenceKeypoint.new(1, 0)})
    pe.Lifetime = NumberRange.new(0.3, 0.6)
    pe.Rate = 25
    pe.Speed = NumberRange.new(1, 2)
    pe.SpreadAngle = Vector2.new(180, 180)
    pe.Parent = body

    return body
end

local function runPortalSequence(char, root, target)
    if os.clock() - lastPortalAt < PORTAL_CD then
        setStatus("ПОРТАЛ: ПЕРЕЗАРЯДКА " .. string.format("%.1f", PORTAL_CD - (os.clock() - lastPortalAt)) .. "с")
        return
    end
    lastPortalAt = os.clock()
    setStatus("ПОРТАЛ: ЦЕЛЬ — " .. target.Name)

    task.spawn(function()
        local look = root.CFrame.LookVector
        look = Vector3.new(look.X, 0, look.Z)
        if look.Magnitude < 0.05 then look = Vector3.new(0, 0, -1) end
        look = look.Unit
        local p1Pos = root.Position + look * 4.5 + Vector3.new(0, 0.5, 0)
        local p1CF = CFrame.lookAt(p1Pos, root.Position + Vector3.new(0, 0.5, 0))
        local p1 = makePortal(p1CF)
        playSoundAt(p1.Host, CONFIG.HoloDodgeSoundId, 1.2, 0.7, false)
        setStatus("ПОРТАЛ: ОТКРЫТ // ВБРОС БОМБЫ...")

        task.wait(0.35)

        local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or root
        local bomb = portalBuildBomb(hand.Position)
        playSoundAt(bomb, CONFIG.BombTickId, 1.5, 1.3, false)
        TweenService:Create(bomb, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {CFrame = CFrame.new(p1.Center), Size = Vector3.new(0.15, 0.15, 0.15)}):Play()

        task.wait(0.5)
        if bomb.Parent then bomb:Destroy() end
        p1.Close()
        setStatus("ПОРТАЛ: БОМБА В РАЗЛОМЕ")

        task.wait(0.4)

        if not (target and target.Parent) then
            setStatus("ПОРТАЛ: ЦЕЛЬ ПРОПАЛА")
            return
        end
        local vRoot = target:FindFirstChild("HumanoidRootPart")
        local vHum = target:FindFirstChildOfClass("Humanoid")
        if not vRoot or not vHum or vHum.Health <= 0 then
            setStatus("ПОРТАЛ: ЦЕЛЬ МЕРТВА")
            return
        end

        local vHead = target:FindFirstChild("Head")
        local aimPos = (vHead and vHead.Position or vRoot.Position) + Vector3.new(0, 10, 0)
        local p2CF = CFrame.lookAt(aimPos, aimPos + Vector3.new(0, -1, 0), Vector3.new(1, 0, 0))
        local p2 = makePortal(p2CF)
        playSoundAt(p2.Host, CONFIG.HoloDodgeSoundId, 1.2, 0.85, false)
        setStatus("ПОРТАЛ: ДОСТАВКА НАД " .. target.Name)

        task.wait(0.35)

        local bomb2 = portalBuildBomb(p2.Center)
        task.wait(0.2)
        local dropPos = aimPos - Vector3.new(0, 9.4, 0)
        TweenService:Create(bomb2, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {CFrame = CFrame.new(dropPos)}):Play()
        task.wait(0.34)
        local boomPos = bomb2.Parent and bomb2.Position or dropPos
        if bomb2.Parent then bomb2:Destroy() end
        p2.Close()
        bombBlast(boomPos)
        setStatus("ПОРТАЛ: БУМ // " .. target.Name)
    end)
end

