_G.__npShowBombTrajectory = function(origin, vel)
    if trajLock then return end
    trajLock = true
    task.spawn(function()
        task.wait(0.35)
        trajLock = false
    end)

    task.spawn(function()
        local folder = Instance.new("Folder")
        folder.Name = "PrimeBombTrajectory"
        folder.Parent = workspace
        Debris:AddItem(folder, 2.6)

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local excl = {folder}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Character then table.insert(excl, pl.Character) end
        end
        rp.FilterDescendantsInstances = excl

        local g = Vector3.new(0, -workspace.Gravity, 0)
        local dt = 0.05
        local pos = origin
        local v = vel
        local t = 0
        local landed = nil

        while t < 3 do
            local nextPos = pos + v * dt + g * (0.5 * dt * dt)
            local dirv = nextPos - pos
            local len = dirv.Magnitude
            if len > 0.01 then
                local hit = workspace:Raycast(pos, dirv.Unit * (len + 0.4), rp)
                if hit then
                    landed = hit.Position
                    break
                end
            end
            pos = nextPos
            v = v + g * dt
            t += dt

            if (math.floor(t / dt) % 2) == 0 then
                local d = trajPart("PrimeTrajDot", Vector3.new(0.28, 0.28, 0.28))
                d.CFrame = CFrame.new(pos)
                d.Parent = folder
                task.delay(0.8, function()
                    if d.Parent then
                        TweenService:Create(d, TweenInfo.new(0.5), {Transparency = 1}):Play()
                    end
                end)
            end
        end

        if landed then
            local ring = trajPart("PrimeTrajRing", Vector3.new(0.08, 1.2, 1.2), Enum.PartType.Cylinder, 0.1)
            ring.CFrame = CFrame.new(landed + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
            ring.Parent = folder
            TweenService:Create(ring, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Size = Vector3.new(0.06, 6, 6), Transparency = 0.85}):Play()
        end
    end)
end
