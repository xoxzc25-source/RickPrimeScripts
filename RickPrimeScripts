local function bioPart(name, finalSize, color, material, duration, attachTo, baseOffset, transparency, isCylinder, limbTag)
    local char = LocalPlayer.Character
    if not char or not attachTo then return nil end
    local part = Instance.new("Part")
    part.Name = "Nano" .. name
    part.Color, part.Material, part.Transparency = color, material, transparency or 0
    part.CanCollide, part.CanTouch, part.CanQuery, part.Massless, part.Anchored = false, false, false, true, false
    part.CastShadow = false
    local startC0, endC0
    if isCylinder then
        part.Shape = Enum.PartType.Cylinder
        part.Size = Vector3.new(0.05, finalSize.Y, finalSize.Z)
        startC0 = baseOffset * CYL_ROT * CFrame.new(-0.025, 0, 0)
        endC0 = baseOffset * CYL_ROT * CFrame.new(-finalSize.X / 2, 0, 0)
    else
        part.Size = Vector3.new(finalSize.X, 0.05, finalSize.Z)
        startC0 = baseOffset * CFrame.new(0, -0.025, 0)
        endC0 = baseOffset * CFrame.new(0, -finalSize.Y / 2, 0)
    end
    part.Parent = char
    local weld = Instance.new("Weld")
    weld.Part0, weld.Part1 = attachTo, part
    weld.C0 = startC0
    weld.Parent = part
    finalSizes[part] = finalSize
    table.insert(activePrints, {Instance = part, Limb = limbTag, Mode = "Plain"})
    local info = TweenInfo.new(duration * CONFIG.RegenSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    TweenService:Create(part, info, {Size = finalSize}):Play()
    TweenService:Create(weld, info, {C0 = endC0}):Play()
    return part
end

local function bioNode(name, size, color, material, duration, host, frac, finalTransparency, isBall, axis, limbTag, rot)
    local char = LocalPlayer.Character
    if not char or not host then return nil end
    local part = Instance.new("Part")
    part.Name = "Nano" .. name
    part.Color, part.Material = color, material
    part.Transparency = 1
    part.CanCollide, part.CanTouch, part.CanQuery, part.Massless, part.Anchored = false, false, false, true, false
    part.CastShadow = false
    if isBall then part.Shape = Enum.PartType.Ball end
    part.Size = size
    part.Parent = char
    rot = rot or CFrame.new()
    axis = axis or "Y"
    local function c0For(sz)
        if axis == "X" then
            return CFrame.new(sz.X * frac, 0, 0) * rot
        end
        return CFrame.new(0, sz.Y * frac, 0) * rot
    end
    local weld = Instance.new("Weld")
    weld.Part0, weld.Part1 = host, part
    weld.C0 = c0For(host.Size)
    weld.Parent = part
    table.insert(activePrints, {Instance = part, Limb = limbTag, Mode = "Plain"})
    local info = TweenInfo.new(duration * CONFIG.RegenSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local fin = finalSizes[host]
    if fin and fin ~= host.Size then
        TweenService:Create(weld, info, {C0 = c0For(fin)}):Play()
    end
    TweenService:Create(part, info, {Transparency = finalTransparency or 0.15}):Play()
    return part
end

local function spawnScanner(host, crossX, crossZ, limbTag, isCyl, dur)
    local char = LocalPlayer.Character
    if not char or not host then return nil end
    local scan
    if isCyl then
        scan = newFxPart("NanoScanner", Vector3.new(0.05, crossZ * 1.3, crossX * 1.3), CONFIG.BotColor, Enum.Material.Neon, 0.15, char)
        scan.Shape = Enum.PartType.Cylinder
    else
        scan = newFxPart("NanoScanner", Vector3.new(crossX * 1.3, 0.05, crossZ * 1.3), CONFIG.BotColor, Enum.Material.Neon, 0.15, char)
    end
    local fin = finalSizes[host] or host.Size
    local c0a, c0b
    if isCyl then
        c0a, c0b = CFrame.new(-host.Size.X / 2, 0, 0), CFrame.new(-fin.X / 2, 0, 0)
    else
        c0a, c0b = CFrame.new(0, -host.Size.Y / 2, 0), CFrame.new(0, -fin.Y / 2, 0)
    end
    local weld = Instance.new("Weld")
    weld.Part0, weld.Part1 = host, scan
    weld.C0 = c0a
    weld.Parent = scan
    TweenService:Create(weld,
        TweenInfo.new((dur or BONE_FADE) * CONFIG.RegenSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {C0 = c0b}):Play()
    local emitter = Instance.new("ParticleEmitter")
    emitter.Color = ColorSequence.new(CONFIG.BotColor)
    emitter.LightEmission = 1
    emitter.Size = NumberSequence.new(0.25, 0)
    emitter.Lifetime = NumberRange.new(0.15, 0.35)
    emitter.Rate = 30
    emitter.Speed = NumberRange.new(1, 3)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Parent = scan
    table.insert(activePrints, {Instance = scan, Limb = limbTag, Mode = "Plain"})
    return scan
end

local function buildNerveSystem(anchorPart, boneLen, boneDiameter, bone, topOffset, limbTag)
    local L = lite()
    local rNerve = boneDiameter / 2 + 0.05
    local rBlood = boneDiameter / 2 + 0.03
    local rCap   = boneDiameter / 2 + 0.06
    local dirs = L and { {rNerve, rNerve}, {-rNerve, -rNerve} }
        or { {rNerve, rNerve}, {-rNerve, rNerve}, {rNerve, -rNerve}, {-rNerve, -rNerve} }
    for i, d in ipairs(dirs) do
        local s = bioPart("Nerve" .. i, Vector3.new(0.04, boneLen * 1.06, 0.04), NERVE_COLOR,
            Enum.Material.SmoothPlastic, NERVE_FADE, anchorPart, topOffset * CFrame.new(d[1], 0, d[2]), 0, false, limbTag)
        if s and not L then
            bioNode("Ganglion", Vector3.new(0.085, 0.085, 0.085), NERVE_NODE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, s, 0.25, 0, true, "Y", limbTag)
            bioNode("Ganglion", Vector3.new(0.085, 0.085, 0.085), NERVE_NODE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, s, -0.15, 0, true, "Y", limbTag)
        end
    end
    local arteryDirs = L and { {-rBlood, 0} } or { {-rBlood, 0}, {rBlood * 0.7, rBlood * 0.7} }
    for i, d in ipairs(arteryDirs) do
        bioPart("Artery" .. i, Vector3.new(0.05, boneLen * 1.0, 0.05), ARTERY_COLOR,
            Enum.Material.SmoothPlastic, NERVE_FADE, anchorPart, topOffset * CFrame.new(d[1], 0, d[2]), 0, false, limbTag)
    end
    local veinDirs = L and { {0, -rBlood} } or { {0, -rBlood}, {-rBlood * 0.7, rBlood * 0.7} }
    for i, d in ipairs(veinDirs) do
        bioPart("Vein" .. i, Vector3.new(0.05, boneLen * 1.02, 0.05), VEIN_COLOR,
            Enum.Material.SmoothPlastic, NERVE_FADE, anchorPart, topOffset * CFrame.new(d[1], 0, d[2]), 0, false, limbTag)
    end
    if L then return end
    for i = 1, 6 do
        local angle = (i - 1) * math.pi / 3 + math.pi / 12
        local capColor = (i % 2 == 0) and ARTERY_COLOR or VEIN_COLOR
        bioPart("Capillary" .. i, Vector3.new(0.025, boneLen * (0.82 + (i % 3) * 0.09), 0.025), capColor,
            Enum.Material.SmoothPlastic, NERVE_FADE, anchorPart, topOffset * CFrame.new(math.cos(angle)*rCap, 0, math.sin(angle)*rCap), 0, false, limbTag)
    end
    local barLen = rNerve * 2 + 0.1
    bioNode("NerveBarX", Vector3.new(barLen, 0.03, 0.03), NERVE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, bone, 0.2, 0, false, "X", limbTag, CFrame.Angles(0, 0, math.rad(90)))
    bioNode("NerveBarX", Vector3.new(barLen, 0.03, 0.03), NERVE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, bone, -0.1, 0, false, "X", limbTag, CFrame.Angles(0, 0, math.rad(90)))
    bioNode("NerveBarZ", Vector3.new(0.03, 0.03, barLen), NERVE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, bone, 0.05, 0, false, "X", limbTag)
end

