activateDouble = function()
    if not _G.__npDroneMounted then
        if _G.__npPlayerFree then _G.__npPlayerFree() end
    end

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not (myChar and myHum and myRoot) or myHum.Health <= 0 then
        setStatus("ДВОЙНИК: НЕТ ТЕЛА")
        return
    end
    local session = doubleSession

    if doubleState == "SWAPPED" then
        if savedMyCF and myRoot.Parent then
            myRoot.CFrame = savedMyCF + Vector3.new(0, 0.5, 0)
            fxFlash(myRoot.Position, 0.6, 5, Color3.fromRGB(210, 248, 255), 0.3, 6, 14)
