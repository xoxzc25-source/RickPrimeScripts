local function rayParams(list)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = list
    return p
end

local function allCharacters(extra)
    local list = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then table.insert(list, pl.Character) end
    end
    if extra then table.insert(list, extra) end
    return list
end

local function alignedCF(pos, normal)
    normal = normal.Unit
    local ref = (math.abs(normal.Y) > 0.99) and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
    local right = ref:Cross(normal).Unit
    return CFrame.fromMatrix(pos, right, normal)
end

local DISC = CFrame.Angles(0, 0, math.rad(90))

local function emitterHost(cf, life)
    local h = Instance.new("Part")
    h.Name = "PrimeBombHost"
    h.Anchored, h.Transparency = true, 1
    h.Size = Vector3.new(0.2, 0.2, 0.2)
    h.CanCollide, h.CanTouch, h.CanQuery = false, false, false
    h.CastShadow = false
    h.CFrame = cf
    h.Parent = workspace
    Debris:AddItem(h, life)
    return h
end

local function makeCrater(pos, normal, hitInst, R)
    local base = alignedCF(pos, normal)
    local folder = Instance.new("Folder")
    folder.Name = "PrimeCrater"
    folder.Parent = workspace
    table.insert(craters, folder)
    if #craters > 6 then
        local old = table.remove(craters, 1)
        if old and old.Parent then old:Destroy() end
    end

    local carved = false
    if CONFIG.CraterTerrain and hitInst == workspace.Terrain then
        carved = pcall(function()
            workspace.Terrain:FillBall(pos - normal.Unit * (R * 0.12), R * 0.5, Enum.Material.Air)
        end)
    end

    local glows = {}
    local rng = Random.new(math.floor(os.clock() * 1000) % 100000)
    local CYLS = Enum.PartType.Cylinder

    local function piece(name, size, color, material, cf, transp, shape)
        local p = Instance.new("Part")
        p.Name = name
        if shape then p.Shape = shape end
        p.Size, p.Color, p.Material, p.Transparency = size, color, material, transp or 0
        p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
        p.CFrame = cf
        p.Parent = folder
        return p
    end

    piece("Scorch", Vector3.new(0.04, R * 2.2, R * 2.2), Color3.fromRGB(14, 11, 18), Enum.Material.Slate,
        base * CFrame.new(0, 0.03, 0) * DISC, 0.3, CYLS)
    piece("Scorch2", Vector3.new(0.05, R * 1.55, R * 1.55), Color3.fromRGB(9, 7, 13), Enum.Material.Slate,
        base * CFrame.new(0, 0.05, 0) * DISC, 0.12, CYLS)

    if not carved then
        piece("Pit", Vector3.new(0.06, R * 0.85, R * 0.85), Color3.fromRGB(5, 3, 8), Enum.Material.Slate,
            base * CFrame.new(0, 0.07, 0) * DISC, 0, CYLS)
        local gl = piece("PitGlow", Vector3.new(0.05, R * 0.5, R * 0.5), BOMB_PINK, Enum.Material.Neon,
            base * CFrame.new(0, 0.075, 0) * DISC, 0.6, CYLS)
        table.insert(glows, {part = gl, base = 0.6})
        piece("PitCore", Vector3.new(0.07, R * 0.42, R * 0.42), Color3.fromRGB(0, 0, 0), Enum.Material.SmoothPlastic,
            base * CFrame.new(0, 0.085, 0) * DISC, 0, CYLS)
        for i = 1, 14 do
            local a = (i / 14) * math.pi * 2
            piece("Wall", Vector3.new(R * 0.2, 0.12, R * 0.24), Color3.fromRGB(22, 18, 28), Enum.Material.Slate,
                base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.1, -R * 0.34) * CFrame.Angles(math.rad(26), 0, 0), 0)
        end
    end

    for i = 1, 10 do
        local a = (i / 10) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
        local r = R * rng:NextNumber(0.2, 0.5)
        local hgt = rng:NextNumber(0.6, 1.6)
        piece("Spike", Vector3.new(0.16, hgt, 0.16), BOMB_PINK, Enum.Material.Neon,
            base * CFrame.Angles(0, a, 0) * CFrame.new(0, hgt / 2 + 0.05, -r) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), 0, rng:NextNumber(-0.35, 0.35)),
            0.25, Enum.PartType.Ball)
    end

    for _ = 1, 24 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = R * rng:NextNumber(0.5, 0.72)
        local s = rng:NextNumber(0.35, 1.2)
        piece("Rubble",
            Vector3.new(s * rng:NextNumber(0.8, 1.8), s * rng:NextNumber(0.4, 0.9), s * rng:NextNumber(0.8, 1.5)),
            Color3.fromRGB(rng:NextInteger(26, 48), rng:NextInteger(22, 38), rng:NextInteger(34, 56)),
            Enum.Material.Slate,
            base * CFrame.Angles(0, a, 0) * CFrame.new(0, s * 0.3, -r)
                * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6), rng:NextNumber(-0.5, 0.5)), 0)
    end

    local function crack(pt, ang, segs, w)
        for s = 1, segs do
            local len = R * rng:NextNumber(0.18, 0.34)
            ang = ang + rng:NextNumber(-0.4, 0.4)
            local dirv = Vector3.new(math.cos(ang), 0, math.sin(ang))
            local nxt = pt + dirv * len
            local mid = (pt + nxt) / 2 + Vector3.new(0, 0.06, 0)
            local cf = base * CFrame.lookAt(mid, nxt + Vector3.new(0, 0.06, 0))
            piece("Crack", Vector3.new(w, 0.03, len * 1.05), Color3.fromRGB(4, 3, 6), Enum.Material.SmoothPlastic, cf, 0)
            local g = piece("CrackGlow", Vector3.new(w * 0.38, 0.035, len), BOMB_PINK, Enum.Material.Neon,
                cf * CFrame.new(0, 0.01, 0), 0.35)
            table.insert(glows, {part = g, base = 0.35})
            if s == 2 and w > 0.12 and rng:NextNumber() < 0.6 then
                crack(nxt, ang + rng:NextNumber(-1.1, 1.1), 2, w * 0.6)
            end
            pt = nxt
            w = w * 0.8
        end
    end
    for i = 1, 14 do
        local a = (i / 14) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
        crack(Vector3.new(math.cos(a), 0, math.sin(a)) * (R * 0.3), a, 3, 0.28)
    end

    task.spawn(function()
        local t0 = os.clock()
        while folder.Parent do
            local t = os.clock() - t0
            local fade = math.clamp((t - 2) / math.max(CONFIG.CraterLife - 4, 2), 0, 1)
            for _, g in ipairs(glows) do
                if g.part.Parent then
                    g.part.Transparency = math.clamp(g.base + 0.12 * math.sin(t * 3 + g.part.Position.X) + fade * (1 - g.base), 0, 1)
                end
            end
            task.wait(0.1)
        end
    end)

    task.delay(CONFIG.CraterLife, function()
        if folder.Parent then
            for _, p in ipairs(folder:GetChildren()) do
                TweenService:Create(p, TweenInfo.new(2), {Transparency = 1}):Play()
            end
            Debris:AddItem(folder, 2.2)
        end
    end)
end

local function camShake(pos, R)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local power = math.clamp(1 - (root.Position - pos).Magnitude / (R * 5), 0, 1)
    if power <= 0.02 then return end
    task.spawn(function()
        local t0 = os.clock()
        local dur = 1.1 + power * 1.0
        while os.clock() - t0 < dur do
            local a = 1 - (os.clock() - t0) / dur
            local m = power * a * 2.0
            if hum.Parent then
                hum.CameraOffset = Vector3.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, (math.random() - 0.5) * m * 0.5)
            end
            RunService.RenderStepped:Wait()
        end
        if hum.Parent then hum.CameraOffset = Vector3.zero end
    end)
