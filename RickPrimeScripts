local function holoEchoes(character, delta)
    local poses = {}
    for _, bp in ipairs(character:GetChildren()) do
        if bp:IsA("BasePart") and bp.Name ~= "HumanoidRootPart" and not isFx(bp)
            and not bp:GetAttribute("NPExclude") and bp.Transparency < 0.95 then
            table.insert(poses, {size = bp.Size, cf = bp.CFrame, head = (bp.Name == "Head")})
        end
    end
    local N = 5
    for k = 1, N do
        local f = k / (N + 1)
        local off = delta * f
        for _, ps in ipairs(poses) do
            local g = newFxPart("PrimeEcho", ps.size,
                (k % 2 == 0) and Color3.fromRGB(210, 248, 255) or CONFIG.BotColor,
                Enum.Material.Neon, 0.5 + (1 - f) * 0.12, nil)
            g.Anchored = true
            if ps.head then g.Shape = Enum.PartType.Ball end
            g.CFrame = ps.cf + off
            g.Parent = workspace
            local dur = 0.22 + 0.4 * f
            TweenService:Create(g, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Transparency = 1, Size = ps.size * 0.8}):Play()
            Debris:AddItem(g, dur + 0.05)
        end
    end
end

