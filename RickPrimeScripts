end

local function buildTorsoSkeleton(parts, tag)
    local upper, lower = torsoHosts(parts)
    if upper then buildRibcage(upper, tag) end
    if lower then
        buildPelvis(lower, 0, tag)
    elseif upper then
        buildPelvis(upper, -upper.Size.Y * 0.375, tag)
    end
end

