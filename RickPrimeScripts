local function decorateBomb(host)
    local function add(name, size, color, material, cf, shape, neon)
        local p = Instance.new("Part")
        p.Name = "PrimeBomb" .. name
        p.Size, p.Color, p.Material = size, color, material
        if shape then p.Shape = shape end
        p.CanCollide, p.CanTouch, p.CanQuery, p.Massless, p.Anchored = false, false, false, true, false
        p.CastShadow = not neon
        local w = Instance.new("Weld")
        w.Part0, w.Part1 = host, p
        w.C0 = cf
        w.Parent = p
        p.Parent = host
        return p
    end

    local CYLS = Enum.PartType.Cylinder
    local BALLS = Enum.PartType.Ball
    local R = host.Size.X / 2

    local N = 18
    local golden = math.pi * (3 - math.sqrt(5))
    for i = 0, N - 1 do
        local y = 1 - (i / math.max(N - 1, 1)) * 2
        local rad = math.sqrt(math.max(0, 1 - y * y))
        local th = golden * i
        local dir = Vector3.new(math.cos(th) * rad, y, math.sin(th) * rad)
        local baseCF = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(0, math.rad(90), 0)
        add("Socket" .. i, Vector3.new(0.18, 0.46, 0.46), BOMB_RIM, Enum.Material.Metal,
            baseCF * CFrame.new(R * 0.86, 0, 0), CYLS)
        add("Glow" .. i, Vector3.new(0.1, 0.3, 0.3), BOMB_PINK, Enum.Material.Neon,
            baseCF * CFrame.new(R * 0.96, 0, 0), CYLS, true)
    end

    local led = add("LED", Vector3.new(0.22, 0.22, 0.22), BOMB_PINK, Enum.Material.Neon,
        CFrame.new(0, R * 1.06, 0), BALLS, true)
    local light = Instance.new("PointLight")
    light.Color = BOMB_PINK
    light.Brightness = 1.4
    light.Range = 9
    light.Parent = led
    return led, light
end

local function buildBombBody(char)
    local body = Instance.new("Part")
    body.Name = "PrimeBombBody"
    body.Shape = Enum.PartType.Ball
    body.Size = Vector3.new(1.4, 1.4, 1.4)
    body.Color = BOMB_SHELL
