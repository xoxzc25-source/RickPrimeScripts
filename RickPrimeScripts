local function busyCount()
    local n = 0
    for _, v in pairs(busyLimbs) do if v then n += 1 end end
    return n
end
local function lite()
    return CONFIG.LiteMode and busyCount() >= 3
end

local function track(conn)
    table.insert(connections, conn)
    if #connections > 150 then
        for i = #connections - 1, 1, -1 do
            if not connections[i].Connected then table.remove(connections, i) end
        end
    end
    return conn
end
local function disconnectAll()
    for i = #connections, 1, -1 do
        if connections[i].Connected then connections[i]:Disconnect() end
        table.remove(connections, i)
    end
end
local function setStatus(t) if statusCallback then statusCallback(t) end end

