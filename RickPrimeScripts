-- диагносточка: ошибки видны прямо в статусе
local function safeCall(tag, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        local msg = "ОШИБКА [" .. tag .. "]: " .. tostring(err)
        setStatus(msg)
        warn("[NanoPrime] " .. msg)
    end
    return ok, err
end

