    setStatus("ДВОЙНИК: ОХОТА // ДУШИТ ПРИ ОСТАНОВКЕ ЦЕЛИ, ПОТОМ [T] - СВОП")

    local clone, rootPart = buildDoubleClone(myChar)
    cloneModel, cloneRoot = clone, rootPart
    cloneHum = clone:FindFirstChildOfClass("Humanoid")

    local fwd = myRoot.CFrame.LookVector
    fwd = Vector3.new(fwd.X, 0, fwd.Z)
    if fwd.Magnitude < 0.05 then fwd = Vector3.new(0, 0, -1) end
    fwd = fwd.Unit
    local sideDir = Vector3.new(-fwd.Z, 0, fwd.X)
    local nearPos = myRoot.Position + fwd * 4 + sideDir * 2
    local groundPos = groundAt(nearPos)

    if rootPart then
        rootPart.Anchored = true
        rootPart.CFrame = CFrame.lookAt(groundPos + Vector3.new(0, 3, 0), myRoot.Position)
    end
    clone.Parent = workspace

    local rigOff = measureRigOffset(clone, rootPart, cloneHum)

    if cloneHum then
        cloneDiedConn = cloneHum.Died:Connect(function()
            if session == doubleSession then
                endDoubleSession("ДВОЙНИК: УНИЧТОЖЕН // СБРОС")
            end
        end)
    end

    local lastMoveTo = 0

    materializeClone(rootPart, cloneHum, groundPos, rigOff, function()
        if session ~= doubleSession or doubleState ~= "HUNTING" then return end
        loadWalkAnim()
        if cloneHum then
            pcall(function() cloneHum:MoveTo(rootPart.Position) end)
        end
        setStatus("ДВОЙНИК: ОХОТА ИДЁТ")
    end)

    cloneConn = RunService.Heartbeat:Connect(function()
        if session ~= doubleSession then return end
        if doubleState ~= "HUNTING" then return end
        local ch = LocalPlayer.Character
        local myR = ch and ch:FindFirstChild("HumanoidRootPart")
        local mh = ch and ch:FindFirstChildOfClass("Humanoid")
        if not myR or not mh or mh.Health <= 0 then
            endDoubleSession("ДВОЙНИК: ТЫ ПОГИБ // СБРОС")
            return
        end
        if not (cloneModel and cloneModel.Parent) or not (cloneRoot and cloneRoot.Parent) or not cloneHum then
            endDoubleSession("ДВОЙНИК: РАЗРУШЕН")
            return
        end

        local now = os.clock()

        local target, tdist = nil, math.huge
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer then
                local m = pl.Character
                local h = m and m:FindFirstChildOfClass("Humanoid")
                local r = m and m:FindFirstChild("HumanoidRootPart")
                if m and r and h and h.Health > 0 and m.Name ~= "NanoShatterPieces" then
                    local dist = (r.Position - cloneRoot.Position).Magnitude
                    if dist < tdist then target, tdist = m, dist end
                end
            end
        end

        if not target then
            local gp = groundAt(cloneRoot.Position)
            cloneRoot.Anchored = true
            cloneRoot.CFrame = CFrame.new(gp + Vector3.new(0, rigOff, 0))
                * (cloneRoot.CFrame - cloneRoot.CFrame.Position)
            return
        end

        local tRoot = target:FindFirstChild("HumanoidRootPart")
        local tHum = target:FindFirstChildOfClass("Humanoid")
        if not (tRoot and tHum) then return end

        local victimSpeed = tRoot.AssemblyLinearVelocity.Magnitude
        local flatVec = Vector3.new(tRoot.Position.X - cloneRoot.Position.X, 0, tRoot.Position.Z - cloneRoot.Position.Z)
        local flatDist = flatVec.Magnitude

        -- душит: держим позу, ждём [T] от тебя. НИКАКОГО АВТО-СВОПА.
        if strangling then
            if tRoot.Parent then
                cloneRoot.Anchored = true
                cloneRoot.CFrame = behindPose(tRoot, rigOff)
            end
            return
        end

        -- начать душить: жертва стоит И клон добежал (видимо)
        if victimSpeed < STOP_SPEED and flatDist <= STRANGLE_RANGE then
            strangling = true
            stopWalkAnim()
            cloneRoot.Anchored = true
            cloneRoot.CFrame = behindPose(tRoot, rigOff)
            doubleVictim = target
            playSoundAt(cloneRoot, CONFIG.HoloDodgeSoundId, 0.8, 1.4, false)
            for i = 1, 3 do
                task.delay(i * 0.15, function()
                    local neckPos = (tRoot.CFrame * CFrame.new(0, 1.4, 0)).Position
                    fxFlash(neckPos, 0.15, 0.9, Color3.fromRGB(255, 60, 80), 0.22, 0, 0)
                end)
            end
            setStatus("ДВОЙНИК: ДУШИТ " .. target.Name .. " // ЖМИ [T] - СВОП")
            return
        end

        -- погоня: перехват траектории
        cloneRoot.Anchored = false
        local vel = tRoot.AssemblyLinearVelocity
        local flatVel = Vector3.new(vel.X, 0, vel.Z)
        local predicted
        if flatVel.Magnitude > 3 then
            predicted = tRoot.Position + flatVel.Unit * flatVel.Magnitude * PREDICT_T
            local pg = groundAt(predicted)
            predicted = Vector3.new(predicted.X, pg.Y + rigOff, predicted.Z)
        else
            predicted = tRoot.Position
        end

        local flat = Vector3.new(predicted.X - cloneRoot.Position.X, 0, predicted.Z - cloneRoot.Position.Z)
        local dist = flat.Magnitude

        if dist > 2.2 then
            if now - lastMoveTo > 0.15 then
                lastMoveTo = now
                pcall(function() cloneHum:MoveTo(predicted) end)
            end
            local speed = cloneRoot.AssemblyLinearVelocity.Magnitude
            if speed > 2 then
                playWalkAnim()
            else
                stopWalkAnim()
            end
        else
            stopWalkAnim()
        end
    end)
end

