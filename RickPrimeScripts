            barBase * CFrame.new(0, -(barHeight / 2 + 0.02), z + toothSpacing / 2), BLOCK)
        table.insert(teeth, {weld = wBot, base = wBot.C0, run = "Bottom"})
    end

    return {
        Parts = parts,
        Motor = motor,
        Bar = bar,
        Teeth = teeth,
        ToothSpacing = toothSpacing,
    }
end

