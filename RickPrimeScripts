            mx = Vector3.new(math.max(mx.X, hi.X), math.max(mx.Y, hi.Y), math.max(mx.Z, hi.Z))
        else
            mn, mx = lo, hi
        end
    end
    if root:IsA("BasePart") then add(root) end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") then add(d) end
    end
    return mn, mx
end

local function recenterPivot(model)
    if not model:IsA("Model") then return end
    pcall(function()
        local mn, mx = visibleBounds(model)
        if not mn then return end
        local c = (mn + mx) / 2
        local piv = model:GetPivot()
        model.PrimaryPart = nil
        model.WorldPivot = CFrame.new(c) * (piv - piv.Position)
    end)
end

local function getTemplate()
    if portalTemplate then return portalTemplate end

    local objs
    local ok, res = pcall(function() return game:GetObjects(PORTAL_ASSET) end)
    if ok and typeof(res) == "table" and #res > 0 then
        objs = res
    else
        local ok2, wrap = pcall(function()
            return game:GetService("InsertService"):LoadAsset(PORTAL_ID)
        end)
        if ok2 and wrap then
            objs = wrap:GetChildren()
            for _, o in ipairs(objs) do o.Parent = nil end
            pcall(function() wrap:Destroy() end)
        end
    end
    if not objs or #objs == 0 then return nil end

    local roots = {}
    for _, o in ipairs(objs) do
        if o:IsA("LuaSourceContainer") then
            pcall(function() o:Destroy() end)
        elseif o:IsA("PVInstance") or o:IsA("Folder") then
            table.insert(roots, o)
        else
            pcall(function() o:Destroy() end)
        end
    end
    if #roots == 0 then return nil end

    local model
    if #roots == 1 and roots[1]:IsA("PVInstance") then
        model = roots[1]
    else
        model = Instance.new("Model")
        for _, o in ipairs(roots) do o.Parent = model end
    end

    local okPrep = pcall(function()
        local function prep(x)
            if x:IsA("BasePart") then
                x.Anchored = true
                x.CanCollide = false
                x.CanTouch = false
                x.CanQuery = false
                x.Massless = true
            elseif x:IsA("LuaSourceContainer") then
                x:Destroy()
            elseif x:IsA("Seat") or x:IsA("VehicleSeat") then
                x.Disabled = true
            end
        end
        prep(model)
        for _, d in ipairs(model:GetDescendants()) do prep(d) end
    end)
    if not okPrep then
        pcall(function() model:Destroy() end)
        return nil
    end

    recenterPivot(model)
    portalTemplate = model
    return portalTemplate
end

local function loadPortalAsset()
    local t = getTemplate()
    if not t then return nil end
    local ok, c = pcall(function() return t:Clone() end)
    if ok and c then return c end
    portalTemplate = nil
    return t
end

local function fitPortal(model, diameter)
    pcall(function()
        local size
        local mn, mx = visibleBounds(model)
        if mn then
            size = mx - mn
        elseif model:IsA("Model") then
            size = model:GetExtentsSize()
        elseif model:IsA("BasePart") then
            size = model.Size
        end
        if size then
            local maxDim = math.max(size.X, size.Y, size.Z)
            if maxDim > 0.01 then
                local k = diameter / maxDim
                if model:IsA("Model") then
                    model:ScaleTo(model:GetScale() * k)
                elseif model:IsA("BasePart") then
                    model.Size = model.Size * k
                end
            end
        end
    end)
end

local function createPortal(model, baseCF, diameter)
    local obj = {
        model = model,
        baseCF = baseCF,
        closing = false,
        fades = {},
    }

    local function consider(x)
        if x:IsA("BasePart") or x:IsA("Decal") or x:IsA("Texture") then
            table.insert(obj.fades, {x, x.Transparency})
        end
    end
    pcall(function()
        consider(model)
        for _, d in ipairs(model:GetDescendants()) do consider(d) end
    end)

    for _, f in ipairs(obj.fades) do
        pcall(function()
            f[1].Transparency = 1
            TweenService:Create(f[1], TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
                {Transparency = f[2]}):Play()
        end)
    end

    pcall(function()
        local host = model:IsA("BasePart") and model
            or (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true))
        if host then
            local pl = Instance.new("PointLight")
            pl.Color = PORTAL_GREEN
            pl.Brightness = 0
            pl.Range = diameter * 2
            pl.Parent = host
            TweenService:Create(pl, TweenInfo.new(0.5), {Brightness = 3}):Play()
            obj.light = pl

            local pe = Instance.new("ParticleEmitter")
            pe.Color = ColorSequence.new(PORTAL_GREEN, PORTAL_WHITE)
            pe.LightEmission = 1
            pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0)})
            pe.Lifetime = NumberRange.new(0.4, 0.9)
            pe.Speed = NumberRange.new(0.5, 2.5)
            pe.SpreadAngle = Vector2.new(180, 180)
            pe.Rate = 55
            pe.Rotation = NumberRange.new(0, 360)
            pe.RotSpeed = NumberRange.new(-200, 200)
            pe.Drag = 1
            pe.Parent = host
            obj.emitter = pe
        end
    end)

    local t0 = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not model.Parent then
            conn:Disconnect()
            return
        end
        local bob = math.sin((os.clock() - t0) * 2) * 0.15
        pcall(function()
            model:PivotTo(CFrame.new(0, bob, 0) * obj.baseCF * MODEL_ROT)
        end)
    end)
    obj.spinConn = conn

    fxFlash(baseCF.Position, 0.6, diameter * 1.6, PORTAL_GREEN, 0.35, 8, 18)
    return obj
end

local function closePortal(obj)
    if not obj or obj.closing then return end
    obj.closing = true
    local model = obj.model
    if not (model and model.Parent) then return end

    pcall(function() if obj.emitter then obj.emitter.Enabled = false end end)
    pcall(function()
        if obj.light then
            TweenService:Create(obj.light, TweenInfo.new(0.35), {Brightness = 0}):Play()
        end
    end)
    for _, f in ipairs(obj.fades or {}) do
        pcall(function()
            if f[1].Parent then
                TweenService:Create(f[1], TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
                    {Transparency = 1}):Play()
            end
        end)
    end
    if model:IsA("Model") then
        task.spawn(function()
            local ok, base = pcall(function() return model:GetScale() end)
            if not ok then return end
            for i = 1, 8 do
                if not model.Parent then break end
                pcall(function() model:ScaleTo(base * (1 - 0.85 * i / 8)) end)
                task.wait(0.045)
            end
        end)
    end
    Debris:AddItem(model, 0.5)
end

local function placeEntrance(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        setStatus("ПОРТАЛ: НЕТ ТЕЛА")
        return nil
    end

    local look = root.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.05 then look = Vector3.new(0, 0, -1) end
    look = look.Unit

    local model = loadPortalAsset()
    if not model then
        setStatus("ПОРТАЛ: АССЕТ НЕ ЗАГРУЗИЛСЯ")
        return nil
    end
    fitPortal(model, PORTAL_SIZE)

    local ground = portalGroundAt(root.Position + look * PORTAL_DIST)
    local center = Vector3.new(ground.X, ground.Y + PORTAL_SIZE / 2 + 0.1, ground.Z)
    local faceTo = Vector3.new(root.Position.X, center.Y, root.Position.Z)
    local baseCF = CFrame.lookAt(center, faceTo)

    pcall(function() model:PivotTo(baseCF * MODEL_ROT) end)
    model.Name = "PrimeGreenPortal"
    model.Parent = workspace

    local obj = createPortal(model, baseCF, PORTAL_SIZE)
    obj.center = center
    return obj
end

local function portalCleanup()
    portalArmed = false
    portalDestChar = nil
    portalSession += 1
    if portalCatchConn then
        pcall(function() portalCatchConn:Disconnect() end)
        portalCatchConn = nil
    end
    if portalRec then
        closePortal(portalRec)
        portalRec = nil
    end
end

local function exitCFrameAbove(pos)
    return CFrame.new(pos + Vector3.new(0, EXIT_HEIGHT, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
end

local function deliverBomb(bomb, rec, vChar, session)
    local center = rec.center
    local startCF = bomb.CFrame

    bomb.Anchored = true
    bomb.CanCollide, bomb.CanTouch, bomb.CanQuery = false, false, false
    bomb:Destroy()

    if session ~= portalSession then return end

    local held
    if _G.__npBuildRickBomb then
        held = _G.__npBuildRickBomb(startCF.Position)
    end
    if not (held and held.Parent) then
        setStatus("ПОРТАЛ: НЕ УДАЛОСЬ СОБРАТЬ БОМБУ")
        return
    end

    setStatus("ПОРТАЛ: БОМБА ПОЙМАНА // ЗАСАСЫВАЕТ...")
    playSoundAt(held, CONFIG.HoloDodgeSoundId, 1.2, 1.3, false)
    fxFlash(held.Position, 0.4, 5, PORTAL_GREEN, 0.3, 4, 10)

    local portalNormal = rec.baseCF.LookVector
    local p0 = startCF.Position
    local p1 = center + portalNormal * 2.6
    local p2 = center + portalNormal * 0.4
    local SUCK_TIME = 0.6
    local s0 = os.clock()
    while held.Parent do
        local a = math.clamp((os.clock() - s0) / SUCK_TIME, 0, 1)
        local e = a * a * (3 - 2 * a)
        local q0 = p0:Lerp(p1, e)
        local q1 = p1:Lerp(p2, e)
        held.CFrame = CFrame.new(q0:Lerp(q1, e))
            * CFrame.Angles((1 - e) * os.clock() * 4, (1 - e) * os.clock() * 3, 0)
        if a >= 1 then break end
        RunService.Heartbeat:Wait()
    end
    if not held.Parent then return end

    for _, d in ipairs(held:GetDescendants()) do
        if d:IsA("BasePart") then
            TweenService:Create(d, TweenInfo.new(0.22), {Transparency = 1}):Play()
        end
    end
    TweenService:Create(held, TweenInfo.new(0.22), {Transparency = 1}):Play()
    task.wait(0.26)
    fxFlash(center, 0.5, PORTAL_SIZE, PORTAL_GREEN, 0.3, 6, 14)
    held:Destroy()

    closePortal(rec)
    task.wait(0.3)
    if session ~= portalSession then return end

    local vRoot = vChar and vChar.Parent and vChar:FindFirstChild("HumanoidRootPart")
    local vHum = vChar and vChar.Parent and vChar:FindFirstChildOfClass("Humanoid")
    local hasVictim = (vRoot and vHum and vHum.Health > 0) and true or false

    local exitObj = nil
    local exitPos
    if hasVictim then
        exitPos = vRoot.Position + Vector3.new(0, EXIT_HEIGHT, 0)
        local exitModel = loadPortalAsset()
        if exitModel then
            fitPortal(exitModel, EXIT_SIZE)
            local cf = exitCFrameAbove(vRoot.Position)
            pcall(function() exitModel:PivotTo(cf * MODEL_ROT) end)
            exitModel.Name = "PrimeGreenPortal"
            exitModel.Parent = workspace
            exitObj = createPortal(exitModel, cf, EXIT_SIZE)
        end
        setStatus("ПОРТАЛ: ДОСТАВКА НАД " .. vChar.Name .. " // ТИКАЕТ 4 СЕК")
    else
        exitPos = center + Vector3.new(0, EXIT_HEIGHT, 0)
        setStatus("ПОРТАЛ: ЦЕЛЬ ПРОПАЛА // БОМБА ВЫПАДАЕТ ЗДЕСЬ")
    end

    task.wait(0.55)
    if session ~= portalSession then
        closePortal(exitObj)
        return
    end

    local bomb2
    if _G.__npBuildRickBomb then
        bomb2 = _G.__npBuildRickBomb(exitPos)
    end
    if not (bomb2 and bomb2.Parent) then
        closePortal(exitObj)
        setStatus("ПОРТАЛ: ОШИБКА СБОРКИ БОМБЫ")
        return
    end
    for _, d in ipairs(bomb2:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Transparency = 1
            TweenService:Create(d, TweenInfo.new(0.3), {Transparency = 0}):Play()
        end
    end
    bomb2.Transparency = 1
    TweenService:Create(bomb2, TweenInfo.new(0.3), {Transparency = 0}):Play()
    playSoundAt(bomb2, CONFIG.HoloDodgeSoundId, 1, 0.8, false)
    fxFlash(exitPos, 0.5, EXIT_SIZE, PORTAL_GREEN, 0.3, 6, 14)

    task.delay(0.45, function()
        closePortal(exitObj)
    end)

    bomb2.Anchored = false
    bomb2.CanCollide = true
    bomb2.CanTouch, bomb2.CanQuery = false, false
    bomb2.AssemblyLinearVelocity = Vector3.new(0, -4, 0)
    bomb2.AssemblyAngularVelocity = Vector3.new(
        math.random() * 3 - 1.5, math.random() * 3 - 1.5, math.random() * 3 - 1.5)

    local led = bomb2:FindFirstChild("PrimeBombLED")
    local ledLight = led and led:FindFirstChildOfClass("PointLight")
    local tickSound = Instance.new("Sound")
    tickSound.Name = "PrimeBombTick"
    local tid = CONFIG.BombTickId
    if typeof(tid) == "number" then tid = "rbxassetid://" .. tid end
    tickSound.SoundId = tid
    tickSound.Volume = 2
    tickSound.RollOffMaxDistance = 90
    tickSound.Parent = bomb2

    local t0 = os.clock()
    local nextBeep = 0
    local lastPos = bomb2.Position
    local voidY = workspace.FallenPartsDestroyHeight
    while bomb2.Parent and (os.clock() - t0) < FUSE_TIME and scriptAlive ~= false do
        local tt = os.clock() - t0
        if tt >= nextBeep then
            tickSound.PlaybackSpeed = 1.1 + 0.9 * (tt / FUSE_TIME)
            tickSound.TimePosition = 0
            tickSound:Play()
            if ledLight and ledLight.Parent then
                ledLight.Brightness = 6
                TweenService:Create(ledLight, TweenInfo.new(0.15), {Brightness = 1.4}):Play()
            end
            if led and led.Parent then
                led.Color = Color3.fromRGB(255, 255, 255)
                TweenService:Create(led, TweenInfo.new(0.12), {Color = PORTAL_GREEN}):Play()
            end
            nextBeep = tt + math.max(0.12, 0.6 * (1 - tt / FUSE_TIME) + 0.1)
        end
        lastPos = bomb2.Position
        local fh = workspace.FallenPartsDestroyHeight
        if fh == fh and lastPos.Y < fh + 15 then
            bomb2.Anchored = true
        end
        task.wait()
    end

    if scriptAlive == false then
        pcall(function() bomb2:Destroy() end)
        return
    end

    local boomPos = bomb2.Parent and bomb2.Position or lastPos
    pcall(function() bomb2:Destroy() end)

    local bb = _G.__npBombBlast
    if bb then
        local okb, err = pcall(bb, boomPos)
        if not okb then
            warn("[NanoPrime] ПОРТАЛ взрыв: " .. tostring(err))
        end
    else
        warn("[NanoPrime] bombBlast недоступен — проверь экспорт в блоке бомбы (Часть 2)")
    end
    setStatus("ПОРТАЛ: БУМ // ДОСТАВЛЕНО")
end

