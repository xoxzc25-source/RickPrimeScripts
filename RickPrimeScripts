local function fireFromTool()
    local tool = pistolTool
    if not tool or not tool.Parent then return end
    local handle = tool:FindFirstChild("Handle")
    local muzzle = handle and handle:FindFirstChild("MuzzleAtt")
    if not muzzle then return end
    if os.clock() - lastFireAt < CONFIG.FireCD then return end
    lastFireAt = os.clock()

    local char = LocalPlayer.Character
    local cam = workspace.CurrentCamera
    if not char or not cam then return end

    local origin = muzzle.WorldPosition
    local m = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(m.X, m.Y)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}

    local aimRes = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    local aimPoint = aimRes and aimRes.Position or (ray.Origin + ray.Direction * 500)
    local dir = aimPoint - origin
    dir = (dir.Magnitude > 0.01) and dir.Unit or ray.Direction

    local res = workspace:Raycast(origin, dir * 500, params)
    local hitPos = res and res.Position or (origin + dir * 500)

    playSoundAt(handle, CONFIG.LaserSoundId, 1.2, 1, false)
    makeMuzzleFlash(origin, dir)
    makeBeam(origin, hitPos)
    animateFire()

    if res then
        makeImpact(res.Position)
        local model = res.Instance:FindFirstAncestorOfClass("Model")
        local hum = model and model:FindFirstChildOfClass("Humanoid")
        if hum and model ~= char then
            enqueueFling(model)
        elseif not model and not res.Instance.Anchored then
            res.Instance.AssemblyLinearVelocity = dir * 55 + Vector3.new(0, 38, 0)
        end
    end
end

