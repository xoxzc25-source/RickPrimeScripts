local setPartGroup, applyCharCollisionGroup, DOUBLE_GROUP, CHAR_GROUP
local groupsUsable = false
do
    local PhysicsService = game:GetService("PhysicsService")
    DOUBLE_GROUP, CHAR_GROUP = "NPrimeDouble", "NPrimeChars"
    pcall(function() PhysicsService:RegisterCollisionGroup(DOUBLE_GROUP) end)
    pcall(function() PhysicsService:RegisterCollisionGroup(CHAR_GROUP) end)
    pcall(function() PhysicsService:CollisionGroupSetCollidable(DOUBLE_GROUP, CHAR_GROUP, false) end)
    pcall(function() PhysicsService:CollisionGroupSetCollidable(DOUBLE_GROUP, "Default", true) end)
    pcall(function() PhysicsService:CollisionGroupSetCollidable(CHAR_GROUP, "Default", true) end)
    pcall(function() PhysicsService:CollisionGroupSetCollidable(CHAR_GROUP, CHAR_GROUP, true) end)
    local testPart = Instance.new("Part")
    pcall(function() testPart.CollisionGroup = DOUBLE_GROUP; groupsUsable = true end)
    testPart:Destroy()

    function setPartGroup(part, group)
        if part and part.Parent then
            pcall(function() part.CollisionGroup = group end)
        end
    end
    function applyCharCollisionGroup(character)
        if not groupsUsable or not character then return end
        for _, d in ipairs(character:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(function() d.CollisionGroup = CHAR_GROUP end)
            end
        end
        character.DescendantAdded:Connect(function(d)
            if d:IsA("BasePart") then
                pcall(function() d.CollisionGroup = CHAR_GROUP end)
            end
        end)
    end
end
for _, pl in ipairs(Players:GetPlayers()) do
    if pl.Character then applyCharCollisionGroup(pl.Character) end
    track(pl.CharacterAdded:Connect(function(c) applyCharCollisionGroup(c) end))
end
track(Players.PlayerAdded:Connect(function(pl)
    track(pl.CharacterAdded:Connect(function(c) applyCharCollisionGroup(c) end))
end))

local function rawLTM(o, v)
    pcall(function() o.LocalTransparencyModifier = v end)
end
local function setLTM(o, v)
    if v < 1 and headHidden[o] then return end
    rawLTM(o, v)
end
local function isFx(d)
    local n = d.Name
    return n:sub(1, 4) == "Nano" or n:sub(1, 5) == "Prime"
end
local function hideObj(d)
    if (d:IsA("BasePart") or d:IsA("Decal")) and not isFx(d) then rawLTM(d, 1) end
end
local function showObj(d)
    if d:IsA("BasePart") or d:IsA("Decal") then setLTM(d, 0) end
end
local function hideCharacter(ch)
    local hiddenParts = {}
    local function onHide(d)
        if d:IsA("BasePart") or d:IsA("Decal") then
            if not isFx(d) then
                hideObj(d)
                table.insert(hiddenParts, d)
            end
        end
    end
    for _, d in ipairs(ch:GetDescendants()) do onHide(d) end
    local c = ch.DescendantAdded:Connect(onHide)
    return function()
        c:Disconnect()
        for _, d in ipairs(hiddenParts) do
            if d and d.Parent then setLTM(d, 0) end
        end
    end
end
local function waitAppearance(timeout)
    local t0 = os.clock()
    while not LocalPlayer:HasAppearanceLoaded() and os.clock() - t0 < timeout do task.wait(0.1) end
end

local function playSoundAt(parent, id, volume, speed, looped)
    if not parent or not id then return nil end
    local s = Instance.new("Sound")
    s.SoundId, s.Volume, s.PlaybackSpeed, s.Looped = id, volume or 1, speed or 1, looped or false
    s.Parent = parent
    s:Play()
    if not looped then
        s.Ended:Connect(function() s:Destroy() end)
        task.delay(10, function() if s and s.Parent then s:Destroy() end end)
    end
    return s
end

local function startPrintSound(parentPart, totalTime)
    printSoundUsers += 1
    if activePrintSound and activePrintSound.Parent then return end
    activePrintSound = playSoundAt(parentPart, PRINT_SOUND_ID, 1, math.clamp(1 / totalTime, 0.3, 1.25), true)
end
local function endPrintSound()
    printSoundUsers -= 1
    if printSoundUsers > 0 then return end
    printSoundUsers = 0
    if activePrintSound then
        pcall(function() activePrintSound:Stop() end)
        pcall(function() activePrintSound:Destroy() end)
        activePrintSound = nil
    end
end

local CYL_ROT = CFrame.Angles(0, 0, math.rad(90))

local function newFxPart(name, size, color, material, transparency, parent)
    local part = Instance.new("Part")
