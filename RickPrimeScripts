local function groundFilter(extra)
    local list = extra or {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then table.insert(list, pl.Character) end
    end
    for _, d in ipairs(workspace:GetChildren()) do
        if isFx(d) or TRASH_NAMES[d.Name] then table.insert(list, d) end
    end
    if cloneModel then table.insert(list, cloneModel) end
    return list
end

local function groundAt(pos)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = groundFilter(nil)
    local res = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -160, 0), rp)
    if res then return res.Position end
    return pos
end

local function measureRigOffset(model, rootPart, hum)
    if not (model and rootPart and rootPart.Parent) then
        if hum then
            if hum.RigType == Enum.HumanoidRigType.R6 then return 3 end
            return (hum.HipHeight or 2) + rootPart.Size.Y / 2
        end
        return 2.8
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Motor6D") then pcall(function() d.Transform = CFrame.new() end) end
    end
    RunService.Heartbeat:Wait()
    local lowest
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") and d ~= rootPart then
            local b = d.Position.Y - d.Size.Y / 2
            if not lowest or b < lowest then lowest = b end
        end
    end
    if lowest then
        return math.clamp(rootPart.Position.Y - lowest, 1.2, 5.2)
    end
    if hum then
        if hum.RigType == Enum.HumanoidRigType.R6 then return 3 end
        return (hum.HipHeight or 2) + rootPart.Size.Y / 2
    end
    return 2.8
end

