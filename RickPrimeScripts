track(RunService.Heartbeat:Connect(function()
    if #activeBots == 0 then return end
    local now = os.clock()

    for i = #activeBots, 1, -1 do
        local b = activeBots[i]
        local part = b.Part
        if not part or not part.Parent or not b.Anchor or not b.Anchor.Parent then
            table.remove(activeBots, i)
        else
            local t = now - b.Born
            local a = 1
            if b.State == "In" then
                a = math.clamp(t / 0.5, 0, 1)
                if a >= 1 then b.State = "Orbit" end
            end
            local r
            if b.State == "Out" then
                local dt = now - b.OutAt
                r = b.Radius + dt * 7
                part.Transparency = math.clamp(dt / 0.4, 0, 1)
                if dt > 0.4 then
                    part:Destroy()
                    table.remove(activeBots, i)
                end
            else
                local ease = a * a * (3 - 2 * a)
                r = 4.5 + (b.Radius - 4.5) * ease
            end
            if part.Parent then
                local angle = b.Phase + t * b.OrbitSpeed
                local bob = math.sin(t * b.BobSpeed + b.Phase) * b.YSpan + (1 - a) * 2.5
                b.Weld.C0 = CFrame.new(math.cos(angle) * r, bob, math.sin(angle) * r)
            end
        end
    end
end))

