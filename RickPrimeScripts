local function buildDoubleClone(char)
    local wasArch = char.Archivable
    char.Archivable = true
    local copy = char:Clone()
    char.Archivable = wasArch
    if not copy then
        copy = Instance.new("Model")
        local b = newFxPart("PrimeDoubleCore", Vector3.new(1.4, 1.4, 1.4), CONFIG.BotColor, Enum.Material.Neon, 0.3, nil)
        b.Anchored = true
        b.Parent = copy
        copy.PrimaryPart = b
        return copy, b
    end
    copy.Name = "PrimeDouble"
    for _, d in ipairs(copy:GetDescendants()) do
        if d:IsA("LuaSourceContainer") or d:IsA("Tool") or d:IsA("Highlight")
            or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail")
            or d:IsA("Light") or d:GetAttribute("NPExclude") or isFx(d) then
            d:Destroy()
        elseif d:IsA("BasePart") then
            d.Anchored = false
            d.Massless = false
            d.CastShadow = false
            d.CanTouch = false
            d.CanQuery = false
            if d.Transparency >= 0.99 then d.Transparency = 0 end
            rawLTM(d, 0)
        elseif d:IsA("Decal") then
            rawLTM(d, 0)
        end
    end
    local hum = copy:FindFirstChildOfClass("Humanoid")
    local rootPart = copy.PrimaryPart or copy:FindFirstChild("HumanoidRootPart") or copy:FindFirstChildWhichIsA("BasePart")
    copy.PrimaryPart = rootPart
    if rootPart then rootPart.CanCollide = false end

    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        hum.RequiresNeck = false
        hum.BreakJointsOnDeath = false
        hum.PlatformStand = false
        hum.AutoRotate = true
        hum.WalkSpeed = DOUBLE_SPEED
    end

    if groupsUsable then
        for _, d in ipairs(copy:GetDescendants()) do
            if d:IsA("BasePart") then setPartGroup(d, DOUBLE_GROUP) end
        end
    else
        local myPos = char:GetPivot().Position
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer and pl.Character then
                local chPos = pl.Character:GetPivot().Position
                if (chPos - myPos).Magnitude < 60 then
                    for _, bp in ipairs(pl.Character:GetChildren()) do
                        if bp:IsA("BasePart")
                            and (bp.Name == "HumanoidRootPart" or bp.Name == "Head" or bp.Name == "Torso" or bp.Name == "UpperTorso") then
                            local nc = Instance.new("NoCollisionConstraint")
                            nc.Part0 = (rootPart or copy:FindFirstChildWhichIsA("BasePart"))
                            nc.Part1 = bp
                            nc.Parent = copy
                        end
                    end
                end
            end
        end
    end

    local hl = Instance.new("Highlight")
    hl.FillColor = CONFIG.BotColor
    hl.FillTransparency = 0.55
    hl.OutlineColor = Color3.fromRGB(190, 240, 255)
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = copy
    return copy, rootPart
end

