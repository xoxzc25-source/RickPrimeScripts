do
local function hookLimbTouches(character, limbTable)
    for limbName, names in pairs(limbTable) do
        for _, partName in ipairs(names) do
            local p = character:FindFirstChild(partName)
            if p then
                track(p.Touched:Connect(function(hit)
                    if not hit then return end
                    if hit:IsDescendantOf(character) then return end
                    if hit == workspace.Terrain then return end
                    if hit.Anchored and hit.AssemblyLinearVelocity.Magnitude < 25 then return end
                    lastHitLimb = limbName
                    lastHitTouchTime = os.clock()
                end))
            end
        end
    end
end

local function setupCharacter(character)
    local hum = character:WaitForChild("Humanoid", 10)
    if not hum then return end
    cancelAllPrints()

    if _G.__npPlayerFree then _G.__npPlayerFree() end
    _G.__npDroneMounted = false

    if pendingHeadDeath then headRegenPending = true end

    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        cam.CameraSubject = hum
    end

    applyCharCollisionGroup(character)

    local rigIsR6 = hum.RigType == Enum.HumanoidRigType.R6
    local limbTable = rigIsR6 and R6_LIMBS or R15_LIMBS

    local allGroups = {}
    for _, names in pairs(limbTable) do table.insert(allGroups, names) end
    table.insert(allGroups, rigIsR6 and TORSO_PARTS.R6 or TORSO_PARTS.R15)
    for _, names in ipairs(allGroups) do
        for _, name in ipairs(names) do
            local p = character:FindFirstChild(name) or character:WaitForChild(name, 3)
            if p then
                skinSnapshots[p] = {Color = p.Color, Material = p.Material, Transparency = p.Transparency}
            end
        end
    end
    local headPart = character:FindFirstChild("Head")
    if headPart then
        skinSnapshots[headPart] = {Color = headPart.Color, Material = headPart.Material, Transparency = headPart.Transparency}
    end

    hookLimbTouches(character, limbTable)

    if pistolOwned then task.delay(0.15, function() safeCall("ПИСТОЛЕТ", givePistol) end) end
    if bombOwned then task.delay(0.2, function() safeCall("БОМБА", giveBomb) end) end
    if sawOwned then
        task.spawn(function()
            task.wait(0.35)
            local t0 = os.clock()
            while (headRegenPending or busyLimbs["Head"]) and os.clock() - t0 < 30 do task.wait(0.1) end
            if sawOwned and LocalPlayer.Character == character then safeCall("ПИЛА", giveSaw) end
        end)
    end

    track(character.ChildRemoved:Connect(function(ch)
        if ch.Name == "Head" and character.Parent then
            spawnBloodBurst(ch.CFrame, 14)
        end
    end))

    track(hum.Died:Connect(function()
        cancelAllPrints()
        local r = character:FindFirstChild("HumanoidRootPart")
        local deathCF = r and r.CFrame or character:GetPivot()
        if r and not r.Anchored then r.Anchored = true end

        if shatterActive then return end
        if CONFIG.HeadRegenOnDeath then
            pendingHeadDeath = deathCF
        end
    end))

    if pendingHeadDeath then
        local deathCF = pendingHeadDeath
        pendingHeadDeath = nil
        task.spawn(function()
            local stopHide = hideCharacter(character)
            local newRoot = character:WaitForChild("HumanoidRootPart", 10)
            if newRoot then
                task.wait(0.2)
                newRoot.CFrame = deathCF
                task.wait(0.25)
                newRoot.CFrame = deathCF
                spawnPortalFlash(newRoot, COLOR_FLASH_OUT)
                playSoundAt(newRoot, SHATTER_SOUND_ID, 2, 1, false)
            end
            waitAppearance(3)
            if character.Parent then
                runHeadPrint(character)
                headRegenPending = false
                for _, d in ipairs(character:GetDescendants()) do showObj(d) end
                setStatus("ТЕЛО НА МЕСТЕ СМЕРТИ // ГОЛОВА СОБИРАЕТСЯ")
            end
            headRegenPending = false
            stopHide()
        end)
    end

    local previousHealth = hum.Health
    track(hum.HealthChanged:Connect(function(newHealth)
        local tookDamage = newHealth < previousHealth

        local currentHP = hum.Health
        if CONFIG.AutoShatter and not shatterActive
            and currentHP > 0 and currentHP <= CONFIG.ShatterHP then
            shatterBody()
        end

        if tookDamage and newHealth > 0 and CONFIG.AutoRegen and not shatterActive then
            local limb
            if os.clock() - lastHitTouchTime <= HIT_WINDOW then
                limb = lastHitLimb
            end
            if not limb or busyLimbs[limb] then limb = pickRandomFreeLimb() end
            if limb then regenerateLimb(limb) end
        end

        if tookDamage and newHealth > 0 and CONFIG.BigHitHeadRegen and not shatterActive
            and (previousHealth - newHealth) >= CONFIG.BigHitHP then
            if _G.__npQuickHeadPrint then _G.__npQuickHeadPrint() end
        end

        previousHealth = hum.Health
    end))
end

