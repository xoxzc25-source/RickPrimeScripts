local function behindPose(vr, rigOff)
    local look = vr.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.05 then look = Vector3.new(0, 0, -1) end
    look = look.Unit
    local behind = vr.Position - look * 2.2
    local gp = groundAt(behind)
    local y = gp.Y + rigOff
    return CFrame.lookAt(Vector3.new(behind.X, y, behind.Z), Vector3.new(vr.Position.X, y, vr.Position.Z))
end

