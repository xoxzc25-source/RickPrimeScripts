    table.insert(sawParts, bloodHost)

    local session = sawSession
    task.spawn(function()
        while session == sawSession and sawOwned do
            local phase = (os.clock() * 3.2) % saw.ToothSpacing
            for _, t in ipairs(saw.Teeth) do
                if t.weld and t.weld.Parent then
                    local dir = (t.run == "Top") and -1 or 1
                    t.weld.C0 = t.base * CFrame.new(0, 0, dir * phase)
                end
