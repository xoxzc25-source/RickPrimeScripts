    for _ = 1, count do
        local s = Instance.new("Part")
        s.Name = "PrimeSpark"
        local sc = 0.09 + math.random() * 0.11
        s.Size = Vector3.new(sc, sc, sc)
        s.Color = (math.random() < 0.5) and CONFIG.BeamColor or Color3.fromRGB(255, 235, 200)
        s.Material = Enum.Material.Neon
        s.Shape = Enum.PartType.Ball
        s.Anchored, s.CanCollide, s.CanTouch, s.CanQuery = true, false, false, false
        s.CastShadow = false
        s.CFrame = originCF * CFrame.new((math.random()-0.5)*0.3, (math.random()-0.5)*0.3, (math.random()-0.5)*0.3)
        s.Parent = workspace
        local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, sc/2, 0); a0.Parent = s
        local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -sc/2, 0); a1.Parent = s
        local tr = Instance.new("Trail")
        tr.Attachment0, tr.Attachment1 = a0, a1
        tr.Color = ColorSequence.new(s.Color)
        tr.LightEmission = 1
        tr.Lifetime = 0.12
        tr.Transparency = NumberSequence.new(0.3, 1)
        tr.Parent = s
        local spreadDir = (baseDir * 0.6 + Vector3.new(math.random()-0.5, math.random()*0.9+0.1, math.random()-0.5))
        if spreadDir.Magnitude < 0.05 then spreadDir = Vector3.new(0, 1, 0) end
        spreadDir = spreadDir.Unit
        local dist = 1 + math.random() * 2.2
        local rise = 0.3 + math.random() * 0.9
        local drop = 0.7 + math.random() * 1.3
        local mid = pos + spreadDir * (dist * 0.55) + Vector3.new(0, rise, 0)
        local fin = pos + Vector3.new(spreadDir.X * dist, -drop, spreadDir.Z * dist)
        local t1 = TweenService:Create(s, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = CFrame.new(mid)})
        t1:Play()
        t1.Completed:Connect(function()
            if s and s.Parent then
                TweenService:Create(s, TweenInfo.new(0.32, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
                    {CFrame = CFrame.new(fin), Transparency = 1}):Play()
            end
        end)
        Debris:AddItem(s, 0.7)
    end
end

local function fxFlash(pos, startSize, endSize, color, dur, lightBrightness, lightRange)
    local flash = Instance.new("Part")
    flash.Name = "PrimeFlash"
    flash.Shape = Enum.PartType.Ball
    flash.Material = Enum.Material.Neon
    flash.Color = color
    flash.Transparency = 0.05
    flash.Size = Vector3.new(startSize, startSize, startSize)
    flash.Anchored, flash.CanCollide, flash.CanTouch, flash.CanQuery = true, false, false, false
    flash.CastShadow = false
    flash.CFrame = CFrame.new(pos)
    flash.Parent = workspace
    local pl
    if lightBrightness and lightBrightness > 0 then
        pl = Instance.new("PointLight")
        pl.Brightness, pl.Range, pl.Color = lightBrightness, lightRange or 10, color
        pl.Parent = flash
    end
    TweenService:Create(flash, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {Size = Vector3.new(endSize, endSize, endSize), Transparency = 1}):Play()
