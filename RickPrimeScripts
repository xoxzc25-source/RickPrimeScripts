local STALE = "nanoprime_stale"

local function headVisualSize(head)
    local m = head:FindFirstChildOfClass("SpecialMesh")
    local base = math.min(head.Size.X, head.Size.Y, head.Size.Z)
    local k = m and m.Scale.Y or 1
    return math.clamp(base * k, 0.9, 1.8)
end

local function attachedToHead(handle, head)
    for _, j in ipairs(handle:GetChildren()) do
        if (j:IsA("JointInstance") or j:IsA("WeldConstraint")) and (j.Part0 == head or j.Part1 == head) then
            return true
        end
    end
    return false
end

local function collectHeadStuff(character, head)
    local list = { head }
    for _, d in ipairs(head:GetDescendants()) do
        if d:IsA("Decal") then table.insert(list, d) end
    end
    for _, ch in ipairs(character:GetChildren()) do
        if ch:IsA("Accessory") then
            local handle = ch:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") and attachedToHead(handle, head) then
                table.insert(list, handle)
                for _, d in ipairs(handle:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("BasePart") then table.insert(list, d) end
                end
            end
        end
    end
    for _, p in ipairs(sawParts) do
        if typeof(p) == "Instance" and p:IsA("BasePart") then table.insert(list, p) end
    end
    return list
end

local function cameraInsideHead(head)
    local cam = workspace.CurrentCamera
    return cam ~= nil and (cam.CFrame.Position - head.Position).Magnitude < 1.4
end

local function spawnShockwave(head, h, color)
    local char = head and head.Parent
    if not char then return end
    local ring = newFxPart("NanoShockwave", Vector3.new(0.06, h * 0.8, h * 0.8), color, Enum.Material.Neon, 0.2, char)
    ring.Shape = Enum.PartType.Cylinder
    local w = Instance.new("Weld")
    w.Part0, w.Part1 = head, ring
    w.C0 = CFrame.Angles(0, 0, math.rad(90))
    w.Parent = ring
    local em = Instance.new("ParticleEmitter")
    em.Color = ColorSequence.new(color)
    em.LightEmission = 1
    em.Size = NumberSequence.new(0.25, 0)
    em.Lifetime = NumberRange.new(0.3, 0.6)
    em.Speed = NumberRange.new(8, 14)
    em.SpreadAngle = Vector2.new(180, 180)
    em.Rate = 0
    em.Parent = ring
    em:Emit(30)
    TweenService:Create(ring, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = Vector3.new(0.06, h * 3.6, h * 3.6), Transparency = 1}):Play()
    Debris:AddItem(ring, 0.8)
end

function runHeadPrint(character, onFinish)
    local head = character and character:FindFirstChild("Head")
    if not head or busyLimbs["Head"] then
        if onFinish then onFinish() end
        return
    end
    busyLimbs["Head"] = true
    local epoch = printEpoch
    setStatus("СБОРКА: Head")

    local stuff = collectHeadStuff(character, head)
    local origT, muted = {}, {}
    for _, p in ipairs(sawParts) do
        if typeof(p) == "Instance" and p:IsA("BasePart") then
            for _, d in ipairs(p:GetChildren()) do
                if d:IsA("ParticleEmitter") and d.Enabled then
                    d.Enabled = false
                    table.insert(muted, d)
                end
            end
        end
    end
    for _, o in ipairs(stuff) do
        headHidden[o] = true
        local t = o.Transparency
        if o == head and t >= 0.99 then t = 0 end
        origT[o] = t
        o.Transparency = 1
        rawLTM(o, 1)
    end

    task.spawn(function()
        local speed = CONFIG.RegenSpeed
        local h = headVisualSize(head)
        local skinColor = head.Color
        local overlays, ovOf, spinners = {}, {}, {}
        local finished = false
        local beat, light = nil, nil
        local rng = Random.new(math.floor(os.clock() * 1000))
        local function stale() return epoch ~= printEpoch or not character.Parent or not head.Parent end
        local function check() if stale() then error(STALE, 0) end end
        local function ti(t, style) return TweenInfo.new(t * speed, style or Enum.EasingStyle.Sine, Enum.EasingDirection.Out) end
        local function stage(txt, pct) setStatus(string.format("СБОРКА: Head // %s %d%%", txt, pct)) end

        startPrintSound(head, (VANISH_TIME + BONE_FADE + NERVE_FADE + FLESH_FADE + SKIN_FADE + 0.35) * speed)

        local function mk(name, size, color, material, cfr, shape, transp)
            local p = Instance.new("Part")
            p.Name = "NanoHead" .. name
            p.Shape = shape or Enum.PartType.Block
            p.Size = size
            p.Color = color
            p.Material = material
            p.Transparency = transp or 0
            p.Massless = true
            p.CastShadow = false
            p.CanCollide, p.CanTouch, p.CanQuery, p.Anchored = false, false, false, false
            p.CFrame = head.CFrame * cfr
            rawLTM(p, 0)
            p.Parent = character
            local w = Instance.new("Weld")
            w.Part0, w.Part1 = head, p
            w.C0 = cfr
            w.Parent = p
            local rec = {Instance = p, Limb = "Head", Mode = "Plain"}
            table.insert(activePrints, rec)
            local ov = {Part = p, Base = p.Transparency}
            table.insert(overlays, ov)
            ovOf[p] = ov
            return p, w, rec, ov
        end

        local function shell(name, color, material, k, dur, finalT)
            local p = nil
            if head.Archivable then p = head:Clone() end
            if p then
                for _, c in ipairs(p:GetChildren()) do
                    if c:IsA("SpecialMesh") then
                        c.TextureId = ""
                    else
                        c:Destroy()
                    end
                end
                if p:IsA("MeshPart") then pcall(function() p.TextureID = "" end) end
                p.Size = head.Size * k
            else
                p = Instance.new("Part")
                p.Shape = Enum.PartType.Ball
                p.Size = Vector3.new(h, h, h) * k
            end
            p.Name = "NanoHead" .. name
            p.Anchored = false
            p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, true
            p.CastShadow = false
            p.Color, p.Material = color, material
            p.Transparency = 1
            p.CFrame = head.CFrame
            rawLTM(p, 0)
            p.Parent = character
            local w = Instance.new("Weld")
            w.Part0, w.Part1 = head, p
            w.Parent = p
            table.insert(activePrints, {Instance = p, Limb = "Head", Mode = "Plain"})
            local ov = {Part = p, Base = finalT or 0}
            table.insert(overlays, ov)
            ovOf[p] = ov
            TweenService:Create(p, ti(dur), {Transparency = finalT or 0}):Play()
            return p
        end

        local function ball(name, d, color, material, cfr, dur, transp)
            local p = mk(name, Vector3.new(0.05, 0.05, 0.05), color, material, cfr, Enum.PartType.Ball, transp)
            TweenService:Create(p, ti(dur), {Size = Vector3.new(d, d, d)}):Play()
            return p
        end
        local function pop(name, size, color, material, cfr, dur)
            local p = mk(name, Vector3.new(0.05, 0.05, 0.05), color, material, cfr)
            TweenService:Create(p, ti(dur), {Size = size}):Play()
            return p
        end
        local function growUp(name, size, color, material, baseCF, dur)
            local p, w = mk(name, Vector3.new(size.X, 0.05, size.Z), color, material, baseCF * CFrame.new(0, 0.025, 0))
            TweenService:Create(p, ti(dur), {Size = size}):Play()
            TweenService:Create(w, ti(dur), {C0 = baseCF * CFrame.new(0, size.Y / 2, 0)}):Play()
            return p
        end
        local function fadeIn(name, size, color, material, cfr, dur, finalT, shape)
            local p, _, _, ov = mk(name, size, color, material, cfr, shape, 1)
            ov.Base = finalT or 0
            TweenService:Create(p, ti(dur), {Transparency = finalT or 0}):Play()
            return p
        end
        local function seg(name, a, b, thick, color, material, dur, finalT)
            local len = (b - a).Magnitude
            if len < 0.02 then return nil end
            return fadeIn(name, Vector3.new(thick, thick, len), color, material, CFrame.lookAt((a + b) / 2, b), dur, finalT)
        end
        local function dissolve(p, dur)
            if not p or not p.Parent then return end
            local ov = ovOf[p]
            if ov then ov.Base = 1 end
            TweenService:Create(p, ti(dur), {Transparency = 1}):Play()
        end
        local function signal(a, b, delay, dur)
            task.delay(delay * speed, function()
                if finished or stale() then return end
                local p, w, _, ov = mk("Signal", Vector3.new(0.1, 0.1, 0.1), Color3.fromRGB(190, 240, 255),
                    Enum.Material.Neon, CFrame.new(a), Enum.PartType.Ball, 0)
                ov.Base = 1
                TweenService:Create(w, ti(dur, Enum.EasingStyle.Linear), {C0 = CFrame.new(b)}):Play()
                TweenService:Create(p, TweenInfo.new(dur * speed, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1}):Play()
            end)
        end

        local T = {charge = VANISH_TIME + 0.25 / speed, bone = BONE_FADE, nerve = NERVE_FADE, brain = NERVE_FADE, flesh = FLESH_FADE, skin = SKIN_FADE + 0.1}
        local yBottom = -h / 2 - 0.2
        local yTop = h / 2 + 0.1
        local DARK = Color3.fromRGB(32, 26, 24)

        local ok, err = pcall(function()
            local L = lite()
            spawnHeadFlash(head, h, COLOR_FLASH_IN)
            spawnBots(head, "Head")

            local stump = mk("Stump", Vector3.new(0.2, 0.2, 0.2), FLESH_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(0, -h / 2, 0), nil, 1)
            local gush = Instance.new("ParticleEmitter")
            gush.Color = ColorSequence.new(BLOOD_COLOR)
            gush.Size = NumberSequence.new(0.16, 0.05)
            gush.Lifetime = NumberRange.new(0.35, 0.7)
            gush.Rate = L and 14 or 26
            gush.Speed = NumberRange.new(3, 7)
            gush.SpreadAngle = Vector2.new(22, 22)
            gush.Acceleration = Vector3.new(0, -35, 0)
            gush.Parent = stump

            local scanRot = CFrame.Angles(0, 0, math.rad(90))
            local scan, scanW = mk("ScanRing", Vector3.new(0.05, h * 1.5, h * 1.5), CONFIG.BotColor, Enum.Material.Neon,
                CFrame.new(0, -h / 2, 0) * scanRot, Enum.PartType.Cylinder, 0.2)
            local sparks = Instance.new("ParticleEmitter")
            sparks.Color = ColorSequence.new(CONFIG.BotColor)
            sparks.LightEmission = 1
            sparks.Size = NumberSequence.new(0.22, 0)
            sparks.Lifetime = NumberRange.new(0.15, 0.35)
            sparks.Rate = L and 30 or 60
            sparks.Speed = NumberRange.new(1, 3)
            sparks.SpreadAngle = Vector2.new(180, 180)
            sparks.Parent = scan
            local function sweep(y0, y1, dur)
                scanW.C0 = CFrame.new(0, y0, 0) * scanRot
                TweenService:Create(scanW, TweenInfo.new(dur * speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    {C0 = CFrame.new(0, y1, 0) * scanRot}):Play()
            end

            local coreCF = CFrame.new(0, h * 0.05, 0)
            local core = ball("Core", h * 0.45, Color3.fromRGB(150, 225, 255), Enum.Material.Neon, coreCF, T.charge, 0.1)
            light = Instance.new("PointLight")
            light.Color = CONFIG.BotColor
            light.Range = 14
            light.Brightness = 0
            light.Parent = core
            TweenService:Create(light, ti(T.charge), {Brightness = 3}):Play()
            local coreRings = {}
            local axes = {Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1)}
            local speeds = {3.2, -4.1, 5}
            for i = 1, 3 do
                local rot = CFrame.Angles(math.rad(60 * (i - 1)), math.rad(30 * i), math.rad(90))
                local rp, rw = mk("CoreRing" .. i, Vector3.new(0.05, h * 1.35, h * 1.35), CONFIG.BotColor,
                    Enum.Material.Neon, coreCF * rot, Enum.PartType.Cylinder, 0.35)
                table.insert(coreRings, rp)
                table.insert(spinners, {w = rw, base = coreCF, rot = rot, axis = axes[i], speed = speeds[i]})
            end
            local clock0 = os.clock()
            beat = RunService.Heartbeat:Connect(function()
                local t = os.clock() - clock0
                for _, s in ipairs(spinners) do
                    if s.w.Parent then
                        s.w.C0 = s.base * CFrame.fromAxisAngle(s.axis, t * s.speed) * s.rot
                    end
                end
            end)

            stage("ЯДРО", 8)
            task.wait(T.charge * speed)
            check()

            TweenService:Create(core, ti(0.25), {Size = Vector3.new(0.05, 0.05, 0.05)}):Play()
            dissolve(core, 0.25)
            for _, rp in ipairs(coreRings) do dissolve(rp, 0.3) end
            spawnHeadFlash(head, h, COLOR_FLASH_OUT)

            stage("ЧЕРЕП", 18)
            sweep(yBottom, yTop, T.bone)
            growUp("Spine", Vector3.new(0.16, h * 0.8, 0.16), BONE_COLOR, Enum.Material.Slate,
                CFrame.new(0, yBottom, h * 0.1), T.bone)
            for i = 1, (L and 2 or 5) do
                local fr = L and (0.1 + 0.5 * (i - 1)) or (0.1 + 0.18 * (i - 1))
                fadeIn("Vertebra" .. i, Vector3.new(0.28, 0.07, 0.24), BONE_COLOR, Enum.Material.Slate,
                    CFrame.new(0, yBottom + h * 0.8 * fr, h * 0.1), T.bone, 0)
            end
            shell("Skull", BONE_COLOR, Enum.Material.Slate, 0.84, T.bone, 0)
            pop("Maxilla", Vector3.new(h * 0.46, h * 0.3, h * 0.28), BONE_COLOR, Enum.Material.Slate,
                CFrame.new(0, -h * 0.1, -h * 0.2), T.bone)
            ball("CheekL", h * 0.16, BONE_COLOR, Enum.Material.Slate, CFrame.new(-h * 0.24, -h * 0.06, -h * 0.26), T.bone)
            ball("CheekR", h * 0.16, BONE_COLOR, Enum.Material.Slate, CFrame.new(h * 0.24, -h * 0.06, -h * 0.26), T.bone)
            pop("Jaw", Vector3.new(h * 0.5, h * 0.12, h * 0.42), BONE_COLOR, Enum.Material.Slate,
                CFrame.new(0, -h * 0.34, -h * 0.1), T.bone)
            ball("SocketL", h * 0.26, DARK, Enum.Material.Slate, CFrame.new(-h * 0.17, h * 0.07, -h * 0.32), T.bone)
            ball("SocketR", h * 0.26, DARK, Enum.Material.Slate, CFrame.new(h * 0.17, h * 0.07, -h * 0.32), T.bone)
            fadeIn("Nasal", Vector3.new(h * 0.08, h * 0.12, h * 0.05), DARK, Enum.Material.Slate,
                CFrame.new(0, -h * 0.08, -h * 0.4), T.bone, 0)
            local teethN = L and 3 or 6
            for i = 1, teethN do
                local x = (i - (teethN + 1) / 2) * h * (L and 0.12 or 0.07)
                fadeIn("TeethU" .. i, Vector3.new(h * 0.06, h * 0.07, h * 0.05), TEETH_COLOR, Enum.Material.SmoothPlastic,
                    CFrame.new(x, -h * 0.2, -h * 0.37), T.bone, 0)
                fadeIn("TeethL" .. i, Vector3.new(h * 0.06, h * 0.07, h * 0.05), TEETH_COLOR, Enum.Material.SmoothPlastic,
                    CFrame.new(x, -h * 0.27, -h * 0.34), T.bone, 0)
            end
            task.wait(T.bone * speed)
            check()

            stage("НЕРВЫ И СОСУДЫ", 36)
            sweep(yTop, yBottom, T.nerve)
            local cordX, cordZ = 0, h * 0.1 - 0.12
            growUp("Cord", Vector3.new(0.08, h * 0.95, 0.08), NERVE_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(cordX, yBottom, cordZ), T.nerve)
            if not L then
                for i = 1, 4 do
                    fadeIn("Ganglion" .. i, Vector3.new(0.1, 0.1, 0.1), NERVE_NODE_COLOR, Enum.Material.SmoothPlastic,
                        CFrame.new(0, yBottom + h * 0.95 * (0.15 + 0.2 * (i - 1)), cordZ), T.nerve, 0, Enum.PartType.Ball)
                end
            end
            growUp("CarotidL", Vector3.new(0.06, h * 0.85, 0.06), ARTERY_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(-0.2, yBottom, 0), T.nerve)
            growUp("CarotidR", Vector3.new(0.06, h * 0.85, 0.06), ARTERY_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(0.2, yBottom, 0), T.nerve)
            growUp("JugularL", Vector3.new(0.06, h * 0.85, 0.06), VEIN_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(-0.3, yBottom, 0.02), T.nerve)
            growUp("JugularR", Vector3.new(0.06, h * 0.85, 0.06), VEIN_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(0.3, yBottom, 0.02), T.nerve)
            local hub = Vector3.new(0, 0, h * 0.06)
            local branchN = L and 4 or 8
            for i = 1, branchN do
                local ang = (i - 1) * math.pi * 2 / branchN
                local tip = Vector3.new(math.cos(ang) * h * 0.3, h * 0.12 + math.sin(ang * 2) * h * 0.08, math.sin(ang) * h * 0.3)
                seg("Branch" .. i, hub, tip, 0.03, NERVE_COLOR, Enum.Material.SmoothPlastic, T.nerve, 0)
            end
            if not L then
                for i = 1, 16 do
                    local u = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 1), rng:NextNumber(-1, 1))
                    if u.Magnitude < 0.1 then u = Vector3.new(0, 1, 0) end
                    u = u.Unit
                    local tv = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
                    local b = (u + tv * 0.45).Unit
                    seg("Capillary" .. i, u * h * 0.42, b * h * 0.42, 0.022,
                        (i % 2 == 0) and ARTERY_COLOR or VEIN_COLOR, Enum.Material.SmoothPlastic, T.nerve, 0.05)
                end
            end
            seg("OpticL", Vector3.new(-h * 0.08, h * 0.08, -h * 0.05), Vector3.new(-h * 0.17, h * 0.07, -h * 0.3), 0.04,
                NERVE_COLOR, Enum.Material.SmoothPlastic, T.nerve, 0)
            seg("OpticR", Vector3.new(h * 0.08, h * 0.08, -h * 0.05), Vector3.new(h * 0.17, h * 0.07, -h * 0.3), 0.04,
                NERVE_COLOR, Enum.Material.SmoothPlastic, T.nerve, 0)
            for i = 0, (L and 1 or 3) do
                signal(Vector3.new(cordX, yBottom, cordZ), Vector3.new(cordX, h * 0.1, cordZ), 0.1 + i * 0.18, 0.45)
            end
            local bl = ball("BrainL", h * 0.44, BRAIN_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(-h * 0.1, h * 0.14, h * 0.02), T.brain)
            local br = ball("BrainR", h * 0.44, BRAIN_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(h * 0.1, h * 0.14, h * 0.02), T.brain)
            for i = 1, (L and 5 or 12) do
                local side = (i % 2 == 0) and 1 or -1
                local u = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.1, 1), rng:NextNumber(-1, 1)).Unit
                local pos = Vector3.new(side * h * 0.1, h * 0.14, h * 0.02) + u * (h * 0.2)
                ball("Gyrus" .. i, h * 0.11, BRAIN_DARK, Enum.Material.SmoothPlastic, CFrame.new(pos), T.brain)
            end
            ball("Cerebellum", h * 0.24, BRAIN_DARK, Enum.Material.SmoothPlastic, CFrame.new(0, -h * 0.04, h * 0.2), T.brain)
            growUp("BrainStem", Vector3.new(0.1, h * 0.3, 0.1), BRAIN_DARK, Enum.Material.SmoothPlastic,
                CFrame.new(0, -h * 0.2, h * 0.1), T.brain)
            for _, sx in ipairs({-1, 1}) do
                local tag = (sx < 0) and "L" or "R"
                ball("Eye" .. tag, h * 0.2, EYE_COLOR, Enum.Material.SmoothPlastic,
                    CFrame.new(sx * h * 0.17, h * 0.07, -h * 0.31), T.brain)
                fadeIn("Iris" .. tag, Vector3.new(h * 0.11, h * 0.11, h * 0.11), IRIS_COLOR, Enum.Material.SmoothPlastic,
                    CFrame.new(sx * h * 0.17, h * 0.07, -h * 0.385), T.brain, 0, Enum.PartType.Ball)
                fadeIn("Pupil" .. tag, Vector3.new(h * 0.06, h * 0.06, h * 0.06), Color3.fromRGB(8, 8, 8), Enum.Material.SmoothPlastic,
                    CFrame.new(sx * h * 0.17, h * 0.07, -h * 0.405), T.brain, 0, Enum.PartType.Ball)
            end
            task.wait(T.brain * speed)
            check()
            for _, p in ipairs({bl, br}) do
                if p.Parent then
                    TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                        {Size = p.Size * 1.07}):Play()
                end
            end

            stage("МЫШЦЫ", 70)
            gush.Enabled = false
            sweep(yTop, yBottom, T.flesh)
            shell("Flesh", FLESH_COLOR, Enum.Material.SmoothPlastic, 1.01, T.flesh, 0.45)
            pop("NeckMuscle", Vector3.new(h * 0.5, h * 0.55, h * 0.45), FLESH_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(0, -h * 0.55, h * 0.05), T.flesh)
            growUp("SternoL", Vector3.new(0.12, h * 0.55, 0.12), FIBER_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(-h * 0.14, -h * 0.8, -h * 0.12), T.flesh)
            growUp("SternoR", Vector3.new(0.12, h * 0.55, 0.12), FIBER_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(h * 0.14, -h * 0.8, -h * 0.12), T.flesh)
            pop("MasseterL", Vector3.new(h * 0.12, h * 0.28, h * 0.2), FLESH_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(-h * 0.3, -h * 0.22, -h * 0.1), T.flesh)
            pop("MasseterR", Vector3.new(h * 0.12, h * 0.28, h * 0.2), FLESH_COLOR, Enum.Material.SmoothPlastic,
                CFrame.new(h * 0.3, -h * 0.22, -h * 0.1), T.flesh)
            if not L then
                for i = 1, 6 do
                    local ang = (i - 1) * math.pi / 3 + math.pi / 6
                    growUp("Fiber" .. i, Vector3.new(0.06, h * 0.5, 0.06), FIBER_COLOR, Enum.Material.SmoothPlastic,
                        CFrame.new(math.cos(ang) * h * 0.21, -h * 0.78, math.sin(ang) * h * 0.21 + h * 0.05), T.flesh)
                end
            end
            fadeIn("Lips", Vector3.new(h * 0.26, h * 0.05, h * 0.04), Color3.fromRGB(190, 70, 70), Enum.Material.SmoothPlastic,
                CFrame.new(0, -h * 0.235, -h * 0.43), T.flesh, 0)
            task.wait(T.flesh * speed)
            check()

            stage("КОЖА", 86)
            sweep(yBottom, yTop, T.skin)
            shell("SkinTone", skinColor, Enum.Material.SmoothPlastic, 1.03, T.skin, 0.25)
            pop("NeckSkin", Vector3.new(h * 0.52, h * 0.57, h * 0.47), skinColor, Enum.Material.SmoothPlastic,
                CFrame.new(0, -h * 0.55, h * 0.05), T.skin)
            local dur = T.skin * speed
            local finalLTM = cameraInsideHead(head) and 1 or 0
            for _, o in ipairs(stuff) do
                if o.Parent then rawLTM(o, finalLTM) end
            end
            if light and light.Parent then
                TweenService:Create(light, TweenInfo.new(dur), {Brightness = 0}):Play()
            end
            local fadeInfo = TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            for _, ov in ipairs(overlays) do
                if ov.Part.Parent then
                    TweenService:Create(ov.Part, fadeInfo, {Transparency = 1}):Play()
                end
            end
            local t0 = os.clock()
            while true do
                check()
                local a = math.clamp((os.clock() - t0) / dur, 0, 1)
                local e = a * a * (3 - 2 * a)
                for _, o in ipairs(stuff) do
                    if o.Parent then o.Transparency = 1 + ((origT[o] or 0) - 1) * e end
                end
                if a >= 1 then break end
                RunService.Heartbeat:Wait()
            end
        end)

        finished = true
        if beat then beat:Disconnect() end
        local aborted = (epoch ~= printEpoch)
        if not ok and err ~= STALE then
            warn("[NanoPrime] ошибка сборки головы:", err)
            setStatus("ОШИБКА // Head")
        end

        for _, ov in ipairs(overlays) do
            if ov.Part and ov.Part.Parent then ov.Part:Destroy() end
        end
        local target = (head.Parent and cameraInsideHead(head)) and 1 or 0
        for _, o in ipairs(stuff) do
            headHidden[o] = nil
            if o.Parent then
                o.Transparency = origT[o] or 0
                rawLTM(o, target)
            end
        end
        for _, d in ipairs(muted) do
            if d.Parent then d.Enabled = true end
        end

        if aborted then return end

        for i = #activePrints, 1, -1 do
            if activePrints[i].Limb == "Head" then
                local inst = activePrints[i].Instance
                if inst and inst.Parent then inst:Destroy() end
                table.remove(activePrints, i)
            end
        end
        for i = #activeBots, 1, -1 do
            if activeBots[i].Limb == "Head" then
                local b = activeBots[i]
                if b.Part and b.Part.Parent then
                    b.State = "Out"; b.OutAt = os.clock()
                else
                    table.remove(activeBots, i)
                end
            end
        end
        if head.Parent then
            spawnHeadFlash(head, h, COLOR_FLASH_OUT)
            spawnShockwave(head, h, COLOR_FLASH_OUT)
        end
        endPrintSound()
        busyLimbs["Head"] = false
        setStatus("ГОТОВО // Head")
        if onFinish then onFinish() end
    end)
end

local function launchSeveredHead(character, head)
    local function strip(inst)
        for _, c in ipairs(inst:GetDescendants()) do
            if c:IsA("JointInstance") or c:IsA("WeldConstraint") or c:IsA("Constraint") or c:IsA("LuaSourceContainer") then
                c:Destroy()
            end
        end
    end
    local function fixDecals(inst)
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("Decal") then rawLTM(d, 0) end
        end
    end

    local clone = head.Archivable and head:Clone()
    if not clone then
        clone = Instance.new("Part")
        clone.Shape = Enum.PartType.Ball
        clone.Size = head.Size
        clone.Color = head.Color
        clone.Material = head.Material
    end
    strip(clone)
    clone.Name = "NanoSeveredHead"
    clone.Anchored = false
    clone.CanCollide = false
    clone.CanTouch = false
    clone.CanQuery = false
    clone.Massless = false
    clone.Transparency = 0
    rawLTM(clone, 0)
    fixDecals(clone)
    clone.CFrame = head.CFrame * CFrame.new(0, 0.3, 0)
    clone.Parent = workspace
    local pieces = {clone}

    for _, ch in ipairs(character:GetChildren()) do
        if ch:IsA("Accessory") then
            local handle = ch:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") and attachedToHead(handle, head) then
                local hc = handle:Clone()
                strip(hc)
                hc.Anchored, hc.CanCollide, hc.CanTouch, hc.CanQuery, hc.Massless = false, false, false, false, true
                rawLTM(hc, 0)
                fixDecals(hc)
                hc.CFrame = handle.CFrame
                hc.Parent = workspace
                local w = Instance.new("WeldConstraint")
                w.Part0, w.Part1 = clone, hc
                w.Parent = hc
                table.insert(pieces, hc)
            end
        end
    end

    for _, bp in ipairs(character:GetChildren()) do
        if bp:IsA("BasePart") then
            local n = Instance.new("NoCollisionConstraint")
            n.Part0, n.Part1 = clone, bp
            n.Parent = clone
        end
    end

    local look = head.CFrame.LookVector
    local launchVel = Vector3.new(look.X, 0, look.Z) * (8 + math.random() * 6)
        + Vector3.new((math.random() - 0.5) * 8, 24 + math.random() * 8, (math.random() - 0.5) * 8)
    local spin = Vector3.new(math.random() * 20 - 10, math.random() * 20 - 10, math.random() * 20 - 10)
    local startPos = clone.Position
    local function kick()
        if not clone.Parent then return end
        clone.Anchored = false
        clone.AssemblyLinearVelocity = launchVel
        clone.AssemblyAngularVelocity = spin
    end
    kick()
    task.spawn(function()
        RunService.Heartbeat:Wait()
        kick()
        task.wait(0.25)
        if clone.Parent then
            clone.CanCollide = true
            if (clone.Position - startPos).Magnitude < 1 then
                clone:ApplyImpulse(launchVel * math.max(clone.AssemblyMass, 0.5))
            end
        end
    end)

    task.delay(4, function()
        for _, p in ipairs(pieces) do
            if p.Parent then
                TweenService:Create(p, TweenInfo.new(1), {Transparency = 1}):Play()
                for _, d in ipairs(p:GetDescendants()) do
                    if d:IsA("Decal") then TweenService:Create(d, TweenInfo.new(1), {Transparency = 1}):Play() end
                end
            end
        end
    end)
    for _, p in ipairs(pieces) do Debris:AddItem(p, 5.2) end
end

